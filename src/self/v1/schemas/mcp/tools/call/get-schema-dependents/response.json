{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One Schema Dependents RPC Output",
  "description": "Get all direct and transitive dependents of a schema in the catalog",
  "examples": [
    {
      "results": [
        {
          "from": "https://example.com/schemas/user.json",
          "to": "https://example.com/schemas/address.json",
          "at": "/properties/address/$ref",
          "kind": "schema",
          "baseDialect": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "from": "https://example.com/api/petstore",
          "to": "https://example.com/schemas/address.json",
          "at": "/components/schemas/Address/$ref",
          "kind": "openapi"
        }
      ]
    }
  ],
  "type": "object",
  "required": [ "results" ],
  "properties": {
    "results": {
      "$ref": "../../../../api/schemas/dependents/response.json"
    }
  },
  "additionalProperties": false
}
