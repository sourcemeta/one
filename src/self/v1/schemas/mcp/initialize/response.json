{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One MCP Initialize Response",
  "description": "Sourcemeta One's response to a client's initialization",
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "protocolVersion": "2025-11-25",
        "capabilities": {
          "resources": {}
        },
        "serverInfo": {
          "name": "sourcemeta-one-enterprise",
          "title": "Sourcemeta One Enterprise",
          "version": "1.0.0",
          "description": "A JSON Schema registry",
          "websiteUrl": "https://example.com"
        },
        "instructions": "Server instructions"
      }
    }
  ],
  "type": "object",
  "required": [ "jsonrpc", "id", "result" ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [ "string", "integer" ]
    },
    "result": {
      "type": "object",
      "required": [
        "protocolVersion",
        "capabilities",
        "serverInfo",
        "instructions"
      ],
      "properties": {
        "protocolVersion": {
          "enum": [ "2025-11-25", "2025-06-18", "2025-03-26" ]
        },
        "capabilities": {
          "type": "object",
          "required": [ "resources" ],
          "properties": {
            "resources": {
              "type": "object",
              "additionalProperties": false
            },
            "tools": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "serverInfo": {
          "type": "object",
          "required": [ "name", "version" ],
          "properties": {
            "name": {
              "enum": [ "sourcemeta-one", "sourcemeta-one-enterprise" ]
            },
            "title": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "websiteUrl": {
              "x-format-assertion": true,
              "type": "string",
              "format": "uri"
            },
            "icons": {
              "$comment": "The addresses a client may draw this instance by, in the one format a client that draws an icon at all must read. Absent when no front end is built to serve them",
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [ "src", "mimeType", "sizes" ],
                "properties": {
                  "src": {
                    "x-format-assertion": true,
                    "type": "string",
                    "format": "uri"
                  },
                  "mimeType": {
                    "const": "image/png"
                  },
                  "sizes": {
                    "type": "array",
                    "maxItems": 1,
                    "minItems": 1,
                    "items": {
                      "enum": [ "192x192", "512x512" ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
