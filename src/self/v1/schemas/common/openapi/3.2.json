{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAPI 3.2 Document",
  "description": "The document format of an OpenAPI Description that declares revision 3.2 of the OpenAPI Specification, leaving every Schema Object within it to the dialect that one declares",
  "examples": [
    {
      "openapi": "3.2.0",
      "info": {
        "title": "Petstore",
        "version": "1.0.0"
      },
      "paths": {
        "/pets": {
          "get": {
            "operationId": "listPets",
            "responses": {
              "200": {
                "description": "Every pet"
              }
            }
          }
        }
      }
    }
  ],
  "x-lint-exclude": "simple_properties_identifiers",
  "$ref": "#/$defs/specification-extensions",
  "type": "object",
  "anyOf": [
    {
      "required": [ "paths" ]
    },
    {
      "required": [ "components" ]
    },
    {
      "required": [ "webhooks" ]
    }
  ],
  "required": [ "openapi", "info" ],
  "properties": {
    "openapi": {
      "type": "string",
      "pattern": "^3\\.2\\.\\d+(-.+)?$"
    },
    "$self": {
      "x-format-assertion": true,
      "type": "string",
      "format": "uri-reference"
    },
    "info": {
      "$ref": "#/$defs/info"
    },
    "jsonSchemaDialect": {
      "default": "https://spec.openapis.org/oas/3.2/dialect/2025-09-17",
      "x-format-assertion": true,
      "type": "string",
      "format": "uri-reference"
    },
    "servers": {
      "default": [
        {
          "url": "/"
        }
      ],
      "type": "array",
      "items": {
        "$ref": "#/$defs/server"
      }
    },
    "paths": {
      "$ref": "#/$defs/paths"
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/path-item"
      }
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/security-requirement"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "externalDocs": {
      "$ref": "#/$defs/external-documentation"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "info": {
      "$comment": "https://spec.openapis.org/oas/v3.2#info-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "title", "version" ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "termsOfService": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri-reference"
        },
        "contact": {
          "$ref": "#/$defs/contact"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "version": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "contact": {
      "$comment": "https://spec.openapis.org/oas/v3.2#contact-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri-reference"
        },
        "email": {
          "x-format-assertion": true,
          "type": "string",
          "format": "email"
        }
      },
      "unevaluatedProperties": false
    },
    "license": {
      "$comment": "https://spec.openapis.org/oas/v3.2#license-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "name" ],
      "properties": {
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "url": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri-reference"
        }
      },
      "unevaluatedProperties": false,
      "dependentSchemas": {
        "identifier": {
          "not": {
            "required": [ "url" ]
          }
        }
      }
    },
    "server": {
      "$comment": "https://spec.openapis.org/oas/v3.2#server-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "url" ],
      "properties": {
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/server-variable"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "server-variable": {
      "$comment": "https://spec.openapis.org/oas/v3.2#server-variable-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "default" ],
      "properties": {
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "unevaluatedProperties": false
    },
    "components": {
      "$comment": "https://spec.openapis.org/oas/v3.2#components-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "$dynamicRef": "#meta"
          }
        },
        "responses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/response-or-reference"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameter-or-reference"
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/example-or-reference"
          }
        },
        "requestBodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/request-body-or-reference"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          }
        },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/security-scheme-or-reference"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/link-or-reference"
          }
        },
        "callbacks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/callbacks-or-reference"
          }
        },
        "pathItems": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path-item"
          }
        },
        "mediaTypes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/media-type-or-reference"
          }
        }
      },
      "patternProperties": {
        "^(?:schemas|responses|parameters|examples|requestBodies|headers|securitySchemes|links|callbacks|pathItems|mediaTypes)$": {
          "$comment": "Enumerating all of the property names in the regex above is necessary for unevaluatedProperties to work as expected",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "paths": {
      "$comment": "https://spec.openapis.org/oas/v3.2#paths-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "patternProperties": {
        "^/": {
          "$ref": "#/$defs/path-item"
        }
      },
      "unevaluatedProperties": false
    },
    "path-item": {
      "$comment": "https://spec.openapis.org/oas/v3.2#path-item-object",
      "x-lint-exclude": "simple_properties_identifiers",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "properties": {
        "$ref": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri-reference"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/server"
          }
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "additionalOperations": {
          "type": "object",
          "propertyNames": {
            "$comment": "RFC9110 restricts methods to \"1*tchar\" in ABNF",
            "not": {
              "enum": [
                "GET",
                "PUT",
                "POST",
                "DELETE",
                "OPTIONS",
                "HEAD",
                "PATCH",
                "TRACE",
                "QUERY"
              ]
            },
            "pattern": "^[a-zA-Z0-9!#$%&'*+.^_`|~-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/operation"
          }
        },
        "get": {
          "$ref": "#/$defs/operation"
        },
        "put": {
          "$ref": "#/$defs/operation"
        },
        "post": {
          "$ref": "#/$defs/operation"
        },
        "delete": {
          "$ref": "#/$defs/operation"
        },
        "options": {
          "$ref": "#/$defs/operation"
        },
        "head": {
          "$ref": "#/$defs/operation"
        },
        "patch": {
          "$ref": "#/$defs/operation"
        },
        "trace": {
          "$ref": "#/$defs/operation"
        },
        "query": {
          "$ref": "#/$defs/operation"
        }
      },
      "unevaluatedProperties": false
    },
    "operation": {
      "$comment": "https://spec.openapis.org/oas/v3.2#operation-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "externalDocs": {
          "$ref": "#/$defs/external-documentation"
        },
        "operationId": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "requestBody": {
          "$ref": "#/$defs/request-body-or-reference"
        },
        "responses": {
          "$ref": "#/$defs/responses"
        },
        "callbacks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/callbacks-or-reference"
          }
        },
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "security": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/security-requirement"
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/server"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "external-documentation": {
      "$comment": "https://spec.openapis.org/oas/v3.2#external-documentation-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "url" ],
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri-reference"
        }
      },
      "unevaluatedProperties": false
    },
    "parameters": {
      "type": "array",
      "not": {
        "allOf": [
          {
            "contains": {
              "type": "object",
              "required": [ "in" ],
              "properties": {
                "in": {
                  "const": "query"
                }
              }
            }
          },
          {
            "contains": {
              "type": "object",
              "required": [ "in" ],
              "properties": {
                "in": {
                  "const": "querystring"
                }
              }
            }
          }
        ]
      },
      "maxContains": 1,
      "minContains": 0,
      "contains": {
        "type": "object",
        "required": [ "in" ],
        "properties": {
          "in": {
            "const": "querystring"
          }
        }
      },
      "items": {
        "$ref": "#/$defs/parameter-or-reference"
      }
    },
    "parameter": {
      "$comment": "https://spec.openapis.org/oas/v3.2#parameter-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/examples"
        },
        {
          "if": {
            "properties": {
              "in": {
                "const": "query"
              }
            }
          },
          "then": {
            "properties": {
              "allowEmptyValue": {
                "default": false,
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "in": {
                "const": "querystring"
              }
            }
          },
          "then": {
            "required": [ "content" ]
          }
        },
        {
          "if": {
            "required": [ "in" ],
            "properties": {
              "in": {
                "const": "path"
              }
            }
          },
          "then": {
            "required": [ "required" ],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [ "schema" ]
        },
        {
          "required": [ "content" ]
        }
      ],
      "required": [ "name", "in" ],
      "properties": {
        "name": {
          "type": "string"
        },
        "in": {
          "enum": [ "query", "querystring", "header", "path", "cookie" ]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "deprecated": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "$dynamicRef": "#meta"
        },
        "content": {
          "$ref": "#/$defs/content",
          "maxProperties": 1,
          "minProperties": 1
        }
      },
      "unevaluatedProperties": false,
      "dependentSchemas": {
        "schema": {
          "allOf": [
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-path"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-header"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-query"
            },
            {
              "$ref": "#/$defs/parameter/dependentSchemas/schema/$defs/styles-for-cookie"
            },
            {
              "$ref": "#/$defs/styles-for-form"
            }
          ],
          "properties": {
            "style": {
              "type": "string"
            },
            "explode": {
              "type": "boolean"
            }
          },
          "$defs": {
            "styles-for-path": {
              "if": {
                "properties": {
                  "in": {
                    "const": "path"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "default": "simple",
                    "enum": [ "matrix", "label", "simple" ]
                  },
                  "allowReserved": {
                    "default": false,
                    "type": "boolean"
                  }
                }
              }
            },
            "styles-for-header": {
              "if": {
                "properties": {
                  "in": {
                    "const": "header"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "default": "simple",
                    "const": "simple"
                  }
                }
              }
            },
            "styles-for-query": {
              "if": {
                "properties": {
                  "in": {
                    "const": "query"
                  }
                }
              },
              "then": {
                "properties": {
                  "style": {
                    "default": "form",
                    "enum": [
                      "form",
                      "spaceDelimited",
                      "pipeDelimited",
                      "deepObject"
                    ]
                  },
                  "allowReserved": {
                    "default": false,
                    "type": "boolean"
                  }
                }
              }
            },
            "styles-for-cookie": {
              "if": {
                "properties": {
                  "in": {
                    "const": "cookie"
                  }
                }
              },
              "then": {
                "if": {
                  "properties": {
                    "style": {
                      "const": "form"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "allowReserved": {
                      "default": false,
                      "type": "boolean"
                    }
                  }
                },
                "properties": {
                  "style": {
                    "default": "form",
                    "enum": [ "form", "cookie" ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "parameter-or-reference": {
      "if": {
        "$ref": "#/$defs/is-reference"
      },
      "then": {
        "$ref": "#/$defs/reference"
      },
      "else": {
        "$ref": "#/$defs/parameter"
      }
    },
    "request-body": {
      "$comment": "https://spec.openapis.org/oas/v3.2#request-body-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "required": [ "content" ],
      "properties": {
        "description": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "required": {
          "default": false,
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    },
    "request-body-or-reference": {
      "if": {
        "$ref": "#/$defs/is-reference"
      },
      "then": {
        "$ref": "#/$defs/reference"
      },
      "else": {
        "$ref": "#/$defs/request-body"
      }
    },
    "content": {
      "$comment": "https://spec.openapis.org/oas/v3.2#fixed-fields-10",
      "type": "object",
      "propertyNames": {
        "x-lint-exclude": "unknown_format_prefix",
        "format": "media-range"
      },
      "additionalProperties": {
        "$ref": "#/$defs/media-type-or-reference"
      }
    },
    "media-type": {
      "$comment": "https://spec.openapis.org/oas/v3.2#media-type-object",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/examples"
        },
        {
          "$ref": "#/$defs/specification-extensions"
        }
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "schema": {
          "$dynamicRef": "#meta"
        },
        "itemSchema": {
          "$dynamicRef": "#meta"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/encoding"
          }
        },
        "prefixEncoding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/encoding"
          }
        },
        "itemEncoding": {
          "$ref": "#/$defs/encoding"
        }
      },
      "unevaluatedProperties": false,
      "dependentSchemas": {
        "encoding": {
          "properties": {
            "prefixEncoding": false,
            "itemEncoding": false
          }
        }
      }
    },
    "media-type-or-reference": {
      "if": {
        "$ref": "#/$defs/is-reference"
      },
      "then": {
        "$ref": "#/$defs/reference"
      },
      "else": {
        "$ref": "#/$defs/media-type"
      }
    },
    "encoding": {
      "$comment": "https://spec.openapis.org/oas/v3.2#encoding-object",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/specification-extensions"
        },
        {
          "$ref": "#/$defs/styles-for-form"
        }
      ],
      "properties": {
        "contentType": {
          "x-lint-exclude": "unknown_format_prefix",
          "type": "string",
          "format": "media-range"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          }
        },
        "style": {
          "enum": [ "form", "spaceDelimited", "pipeDelimited", "deepObject" ]
        },
        "explode": {
          "type": "boolean"
        },
        "allowReserved": {
          "type": "boolean"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/encoding"
          }
        },
        "prefixEncoding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/encoding"
          }
        },
        "itemEncoding": {
          "$ref": "#/$defs/encoding"
        }
      },
      "unevaluatedProperties": false,
      "dependentSchemas": {
        "encoding": {
          "properties": {
            "prefixEncoding": false,
            "itemEncoding": false
          }
        },
        "style": {
          "properties": {
            "allowReserved": {
              "default": false
            }
          }
        },
        "explode": {
          "properties": {
            "style": {
              "default": "form"
            },
            "allowReserved": {
              "default": false
            }
          }
        },
        "allowReserved": {
          "properties": {
            "style": {
              "default": "form"
            }
          }
        }
      }
    },
    "responses": {
      "$comment": "https://spec.openapis.org/oas/v3.2#responses-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "if": {
        "$comment": "either default, or at least one response code property must exist",
        "patternProperties": {
          "^[1-5](?:[0-9]{2}|XX)$": false
        }
      },
      "then": {
        "required": [ "default" ]
      },
      "minProperties": 1,
      "properties": {
        "default": {
          "$ref": "#/$defs/response-or-reference"
        }
      },
      "patternProperties": {
        "^[1-5](?:[0-9]{2}|XX)$": {
          "$ref": "#/$defs/response-or-reference"
        }
      },
      "unevaluatedProperties": false
    },
    "response": {
      "$comment": "https://spec.openapis.org/oas/v3.2#response-object",
      "$ref": "#/$defs/specification-extensions",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/header-or-reference"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "links": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/link-or-reference"
          }
        }
      },
      "unevaluatedProperties": false
    },
