{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One OpenAPI Metadata API Response",
  "description": "The response format for the OpenAPI description metadata API endpoint",
  "examples": [
    {
      "bytes": 2048,
      "bytesBundled": 4096,
      "identifier": "https://example.com/api/petstore",
      "path": "/api/petstore",
      "openapi": "3.1",
      "version": "1.0.0",
      "dialect": "https://spec.openapis.org/oas/3.1/dialect/base",
      "baseDialect": "https://json-schema.org/draft/2020-12/schema",
      "title": "Petstore",
      "description": "A sample API for managing pets",
      "health": 100,
      "dependencies": 3,
      "operations": 12,
      "priority": 50,
      "private": false,
      "breadcrumb": [
        {
          "name": "Home",
          "path": "/"
        }
      ]
    }
  ],
  "$ref": "../../catalog-entry.json",
  "required": [ "breadcrumb", "openapi", "version", "operations" ],
  "properties": {
    "openapi": {
      "enum": [ "3.0", "3.1", "3.2" ]
    },
    "version": {
      "type": "string"
    },
    "operations": {
      "type": "integer",
      "minimum": 0
    },
    "breadcrumb": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "name", "path" ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "x-format-assertion": true,
            "type": "string",
            "format": "uri-reference"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
