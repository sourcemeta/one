{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One Search API Response",
  "description": "The response format for the search API endpoint",
  "examples": [
    [
      {
        "type": "schema",
        "path": "/schemas/user.json",
        "identifier": "https://example.com/schemas/user.json",
        "title": "User Schema",
        "description": "Defines a user object",
        "priority": 50,
        "health": 100
      }
    ]
  ],
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "type",
      "path",
      "identifier",
      "title",
      "description",
      "priority",
      "health"
    ],
    "properties": {
      "type": {
        "enum": [ "schema", "openapi" ]
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "path": {
        "x-format-assertion": true,
        "type": "string",
        "format": "uri-reference"
      },
      "identifier": {
        "x-format-assertion": true,
        "type": "string",
        "format": "uri"
      },
      "priority": {
        "type": "integer",
        "maximum": 100,
        "minimum": 0
      },
      "health": {
        "type": "integer",
        "maximum": 100,
        "minimum": 0
      }
    },
    "additionalProperties": false
  }
}
