{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One Dependency Edge",
  "description": "One reference from a resource of the catalog to another, as both the dependencies and the dependents reports carry it",
  "examples": [
    {
      "from": {
        "identifier": "https://example.com/api/petstore",
        "type": "openapi",
        "baseDialect": "https://json-schema.org/draft/2020-12/schema",
        "location": "/components/schemas/Address/$ref"
      },
      "to": {
        "identifier": "https://example.com/schemas/address",
        "type": "schema",
        "baseDialect": "https://json-schema.org/draft/2020-12/schema"
      }
    }
  ],
  "type": "object",
  "required": [ "from", "to" ],
  "properties": {
    "from": {
      "$ref": "#/$defs/end",
      "required": [ "location" ],
      "properties": {
        "location": {
          "x-format-assertion": true,
          "type": "string",
          "format": "json-pointer"
        }
      },
      "unevaluatedProperties": false
    },
    "to": {
      "$ref": "#/$defs/end",
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "end": {
      "type": "object",
      "required": [ "identifier", "type", "baseDialect" ],
      "properties": {
        "identifier": {
          "x-format-assertion": true,
          "type": "string",
          "format": "uri"
        },
        "type": {
          "enum": [ "schema", "openapi" ]
        },
        "baseDialect": {
          "enum": [
            "https://json-schema.org/draft/2020-12/schema",
            "https://json-schema.org/draft/2020-12/hyper-schema",
            "https://json-schema.org/draft/2019-09/schema",
            "https://json-schema.org/draft/2019-09/hyper-schema",
            "http://json-schema.org/draft-07/schema#",
            "http://json-schema.org/draft-07/hyper-schema#",
            "http://json-schema.org/draft-06/schema#",
            "http://json-schema.org/draft-06/hyper-schema#",
            "http://json-schema.org/draft-04/schema#",
            "http://json-schema.org/draft-04/hyper-schema#",
            "http://json-schema.org/draft-03/schema#",
            "http://json-schema.org/draft-03/hyper-schema#",
            "http://json-schema.org/draft-02/hyper-schema#",
            "http://json-schema.org/draft-01/hyper-schema#",
            "http://json-schema.org/draft-00/hyper-schema#"
          ]
        }
      }
    }
  }
}
