{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One Catalog Entry",
  "description": "The metadata that every entry of the catalog carries, whatever kind of entry it is",
  "examples": [
    {
      "bytes": 512,
      "bytesBundled": 1024,
      "identifier": "https://example.com/schemas/user.json",
      "path": "/schemas/user.json",
      "baseDialect": "https://json-schema.org/draft/2020-12/schema",
      "conformsTo": "https://json-schema.org/draft/2020-12/schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "health": 100,
      "priority": 100,
      "private": false
    }
  ],
  "type": "object",
  "required": [
    "bytes",
    "bytesBundled",
    "identifier",
    "path",
    "baseDialect",
    "conformsTo",
    "dialect",
    "health",
    "priority",
    "private"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "integer",
      "minimum": 0
    },
    "alert": {
      "type": [ "string", "null" ]
    },
    "baseDialect": {
      "x-format-assertion": true,
      "type": "string",
      "format": "uri"
    },
    "conformsTo": {
      "enum": [
        "https://json-schema.org/draft/2020-12/schema",
        "https://json-schema.org/draft/2020-12/hyper-schema",
        "https://json-schema.org/draft/2019-09/schema",
        "https://json-schema.org/draft/2019-09/hyper-schema",
        "http://json-schema.org/draft-07/schema#",
        "http://json-schema.org/draft-07/hyper-schema#",
        "http://json-schema.org/draft-06/schema#",
        "http://json-schema.org/draft-06/hyper-schema#",
        "http://json-schema.org/draft-04/schema#",
        "http://json-schema.org/draft-04/hyper-schema#",
        "http://json-schema.org/draft-03/schema#",
        "http://json-schema.org/draft-03/hyper-schema#",
        "http://json-schema.org/draft-02/hyper-schema#",
        "http://json-schema.org/draft-01/hyper-schema#",
        "http://json-schema.org/draft-00/hyper-schema#",
        "https://spec.openapis.org/oas/v3.0",
        "https://spec.openapis.org/oas/v3.1",
        "https://spec.openapis.org/oas/v3.2"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "bytesBundled": {
      "type": "integer",
      "minimum": 0
    },
    "dialect": {
      "x-format-assertion": true,
      "type": "string",
      "format": "uri"
    },
    "health": {
      "type": "integer",
      "maximum": 100,
      "minimum": 0
    },
    "priority": {
      "type": "integer",
      "maximum": 100,
      "minimum": 0
    },
    "private": {
      "type": "boolean"
    },
    "identifier": {
      "x-format-assertion": true,
      "type": "string",
      "format": "uri"
    },
    "path": {
      "x-format-assertion": true,
      "type": "string",
      "format": "uri-reference"
    }
  }
}
