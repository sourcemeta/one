{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcemeta One Schema Metadata API Response",
  "description": "The response format for the schema metadata API endpoint",
  "examples": [
    {
      "bytes": 512,
      "bytesBundled": 1024,
      "identifier": "https://example.com/schemas/user.json",
      "path": "/schemas/user.json",
      "baseDialect": "https://json-schema.org/draft/2020-12/schema",
      "dialect": "https://json-schema.org/draft/2020-12/schema",
      "health": 100,
      "priority": 100,
      "private": false,
      "metaschema": false,
      "breadcrumb": [
        {
          "name": "Home",
          "path": "/"
        }
      ],
      "examples": []
    }
  ],
  "$ref": "../../catalog-entry.json",
  "required": [ "breadcrumb", "examples", "metaschema" ],
  "properties": {
    "examples": {
      "type": "array",
      "maxItems": 10
    },
    "metaschema": {
      "type": "boolean"
    },
    "conversions": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "draft4",
          "draft6",
          "draft7",
          "2019-09",
          "2020-12",
          "openapi3.1",
          "openapi3.2"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [ "mediaType" ],
        "properties": {
          "mediaType": {
            "const": "application/schema+json"
          }
        },
        "additionalProperties": false
      }
    },
    "breadcrumb": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "name", "path" ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "x-format-assertion": true,
            "type": "string",
            "format": "uri-reference"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
