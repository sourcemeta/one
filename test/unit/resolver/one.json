  "contents": {
    "example": {
      "baseUri": "https://example.com/schemas",
      "path": "./schemas/example",
      "defaultDialect": "http://json-schema.org/draft-07/schema#",
      "resolve": {
        "https://other.com/2020-12-with-id": "./schemas/example/2020-12-with-id.schema.json",
        "https://other.com:443/needs-canonical-key": "./schemas/example/2020-12-with-id.schema.json",
        "https://other.com/needs-json-alternative": "./schemas/example/2020-12-with-id.schema.json"
      }
    },
    "base-slash": {
      "baseUri": "https://example.com/slash/",
      "path": "./schemas/base-slash"
    },
    "meta-draft4": {
      "baseUri": "http://json-schema.org/draft-04",
      "path": "./schemas/meta-draft4"
    },
    "no-base": {
      "path": "./schemas/no-base"
    }
  }
}
