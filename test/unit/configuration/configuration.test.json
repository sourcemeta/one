    {
      "description": "A JWT authentication policy is valid",
      "valid": true,
      "data": {
        "url": "http://localhost:8000",
        "authentication": [
          {
            "type": "jwt",
            "name": "ci",
            "paths": [ "/internal" ],
            "issuer": "https://acme.example.com",
            "audience": "https://schemas.example.com",
            "algorithms": [ "RS256" ]
          }
        ]
      }
    },
    {
      "description": "A JWT authentication policy without an issuer is invalid",
      "valid": false,
      "data": {
        "url": "http://localhost:8000",
        "authentication": [
          {
            "type": "jwt",
            "name": "ci",
            "paths": [ "/internal" ],
            "audience": "https://schemas.example.com",
            "algorithms": [ "RS256" ]
          }
        ]
      }
    },
    {
      "description": "A JWT authentication policy with apiKey keys is invalid",
      "valid": false,
      "data": {
        "url": "http://localhost:8000",
        "authentication": [
          {
            "type": "jwt",
            "name": "ci",
            "paths": [ "/internal" ],
            "issuer": "https://acme.example.com",
            "audience": "https://schemas.example.com",
            "algorithms": [ "RS256" ],
            "keys": [ { "environmentVariable": "ONE_KEY" } ]
          }
        ]
      }
    },
    {
      "description": "A JWT authentication policy with claim rules is valid",
      "valid": true,
      "data": {
        "url": "http://localhost:8000",
        "authentication": [
          {
            "type": "jwt",
            "name": "ci",
            "paths": [ "/internal" ],
            "issuer": "https://acme.example.com",
            "audience": "https://schemas.example.com",
            "algorithms": [ "RS256" ],
            "claims": {
              "groups": [ "platform", "oncall" ],
              "scope": [ "registry:read" ]
            }
          }
        ]
      }
    },
    {
      "description": "A JWT authentication policy naming a provider specific claim is valid",
      "valid": true,
      "data": {
        "url": "http://localhost:8000",
        "authentication": [
          {
            "type": "jwt",
            "name": "ci",
            "paths": [ "/internal" ],
            "issuer": "https://acme.example.com",
            "audience": "https://schemas.example.com",
            "algorithms": [ "RS256" ],
            "claims": { "cognito:groups": [ "platform" ] }
          }
        ]
      }
    },
