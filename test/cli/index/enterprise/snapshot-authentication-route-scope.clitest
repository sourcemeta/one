./schemas/schemas/test-1/%/positions.metapack
./schemas/schemas/test-1/%/schema.metapack
./schemas/schemas/test-1/%/stats.metapack
./state.bin
./version.json
EOF

COMPARE manifest.txt AGAINST expected.txt
