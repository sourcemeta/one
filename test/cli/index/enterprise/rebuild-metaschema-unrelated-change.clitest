// Changing a schema unrelated to a dialect leaves the metadata of the schema
// declared as that dialect alone

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/meta.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/meta"
}
EOF

WRITE schemas/user.json UNTIL EOF
{
  "$schema": "https://example.com/meta",
  "$id": "https://example.com/user"
}
EOF

WRITE schemas/other.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/other"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/schemas/meta.json
2> Detecting: [CWD]/schemas/other.json
2> Detecting: [CWD]/schemas/user.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

WRITE schemas/other.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/other",
  "title": "Edited"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO produced.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN produced.txt

// Nothing describing the schema declared as the dialect is rebuilt
WRITE expected-produced.txt UNTIL EOF
2> (  4%) Producing: schemas/example/schemas/other/%/schema.metapack
2> (  8%) Producing: schemas/example/schemas/other/%/dependencies.metapack
2> ( 13%) Producing: schemas/example/schemas/other/%/locations.metapack
2> ( 17%) Producing: schemas/example/schemas/other/%/positions.metapack
2> ( 21%) Producing: schemas/example/schemas/other/%/schema-2019-09.metapack
2> ( 26%) Producing: schemas/example/schemas/other/%/schema-2020-12.metapack
2> ( 30%) Producing: schemas/example/schemas/other/%/schema-draft7.metapack
2> ( 34%) Producing: schemas/example/schemas/other/%/stats.metapack
2> ( 39%) Producing: schemas/example/schemas/other/%/bundle.metapack
2> ( 43%) Producing: schemas/example/schemas/other/%/health.metapack
2> ( 47%) Producing: explorer/public/example/schemas/other/%/schema.metapack
2> ( 52%) Producing: schemas/example/schemas/other/%/blaze-exhaustive.metapack
2> ( 56%) Producing: schemas/example/schemas/other/%/blaze-fast.metapack
2> ( 60%) Producing: schemas/example/schemas/other/%/editor.metapack
2> ( 65%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 69%) Producing: explorer/public/example/schemas/other/%/schema-html.metapack
2> ( 73%) Producing: explorer/public/example/%/directory.metapack
2> ( 78%) Producing: explorer/public/example/schemas/%/directory-html.metapack
2> ( 82%) Producing: explorer/public/%/directory.metapack
2> ( 86%) Producing: explorer/public/example/%/directory-html.metapack
2> ( 91%) Producing: explorer/public/%/directory-html.metapack
2> ( 95%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
EOF

COMPARE produced.txt AGAINST expected-produced.txt
