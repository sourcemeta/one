WRITE probed_2.txt UNTIL EOF
EOF
COMPARE probe_2.txt AGAINST probed_2.txt

// Second run with --comment "second"

RUN --skip-banner --deterministic one.json output --comment second --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt

