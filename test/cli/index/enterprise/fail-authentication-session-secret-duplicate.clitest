// The secrets a policy names are tried in order, so naming the same variable
// twice adds nothing and reads as the mistake it is: somebody meant to name the
// secret being replaced and named the one replacing it again, leaving a
// rotation that retires nothing while appearing to have been carried out.

MAKE DIRECTORY internal

WRITE internal/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "oidc",
      "name": "corporate",
      "paths": [ "/internal" ],
      "issuer": "https://login.example.com",
      "clientId": "registry",
      "clientSecret": { "environmentVariable": "ONE_TEST_OIDC_CLIENT" },
      "sessionSecrets": [
        { "environmentVariable": "ONE_TEST_OIDC_SESSION" },
        { "environmentVariable": "ONE_TEST_OIDC_SESSION" }
      ]
    }
  ],
  "contents": {
    "internal": { "path": "./internal" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
1> error: Invalid configuration
1>   at path [CWD]/one.json
1> The object value was expected to only define properties "algorithm", "keys", "name", "paths", and "type", but it also defines properties "clientId", "clientSecret", "issuer", and "sessionSecrets"
1>   at instance location "/authentication/0"
1>   at evaluate path "/properties/authentication/items/anyOf/0/required"
1> The value was expected to be an object that defines properties "algorithms", "audience", "issuer", "name", "paths", and "type"
1>   at instance location "/authentication/0"
1>   at evaluate path "/properties/authentication/items/anyOf/1/required"
1> The array value contained the following duplicate item: {"environmentVariable":"ONE_TEST_OIDC_SESSION"}
1>   at instance location "/authentication/0/sessionSecrets"
1>   at evaluate path "/properties/authentication/items/anyOf/2/properties/sessionSecrets/uniqueItems"
1> The object value was expected to validate against the defined properties subschemas
1>   at instance location "/authentication/0"
1>   at evaluate path "/properties/authentication/items/anyOf/2/properties"
1> The object value was expected to validate against at least one of the 3 given subschemas
1>   at instance location "/authentication/0"
1>   at evaluate path "/properties/authentication/items/anyOf"
1> Every item in the array value was expected to validate against the given subschema
1>   at instance location "/authentication"
1>   at evaluate path "/properties/authentication/items"
1> The object value was expected to validate against the 6 defined properties subschemas
1>   at instance location ""
1>   at evaluate path "/properties"
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
