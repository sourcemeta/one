// A directory that holds both a gated and an ungated collection survives in
// every view, but only the view that reaches the gated collection sees the
// subtree underneath it

MAKE DIRECTORY open
MAKE DIRECTORY open/nested
MAKE DIRECTORY closed
MAKE DIRECTORY closed/nested
MAKE DIRECTORY loose

WRITE open/one.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE open/nested/two.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "integer"
}
EOF

WRITE closed/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE closed/nested/deeper.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array"
}
EOF

WRITE loose/plain.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "boolean"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "html": {},
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "vault",
      "paths": [ "/group/closed" ],
      "keys": [ { "environmentVariable": "ONE_KEY_VAULT" } ]
    }
  ],
  "contents": {
    "group": {
      "contents": {
        "open": {
          "baseUri": "https://example.com/group/open/",
          "path": "./open"
        },
        "closed": {
          "baseUri": "https://example.com/group/closed/",
          "path": "./closed"
        }
      }
    },
    "loose": {
      "baseUri": "https://example.com/loose/",
      "path": "./loose"
    }
  }
}
EOF

ENV ONE_KEY_VAULT secret
RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN log_1.txt
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $ONE_PREFIX WITH '[PREFIX]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Detecting: [CWD]/closed/nested/deeper.json (#1)
2> Detecting: [CWD]/closed/secret.json (#2)
2> Detecting: [CWD]/open/nested/two.json (#3)
2> Detecting: [CWD]/open/one.json (#4)
