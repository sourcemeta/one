MAKE DIRECTORY data
MAKE DIRECTORY data/nested

WRITE data/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A",
  "properties": { "value": { "$ref": "urn:example:target" } }
}
EOF

WRITE data/nested/target.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target",
  "type": "string"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "outer": {
      "path": "./data",
      "ignore": [ "./data/nested" ],
      "resolve": { "urn:example:target": "./data/nested/target.json" }
    },
    "inner": { "path": "./data/nested" }
  }
}
EOF
RUN one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/data/a.json
2> Detecting: [CWD]/data/nested/target.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

TREE output INTO manifest.txt
DROP LINES MATCHING '^\./schemas/self(/.*)?$' IN manifest.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN manifest.txt

WRITE expected.txt UNTIL EOF
./authentication.bin
./configuration.json
./explorer
./explorer/public
./explorer/public/%
./explorer/public/%/directory.metapack
./explorer/public/%/login.metapack
./explorer/public/%/mcp.metapack
./explorer/public/%/search.metapack
./explorer/public/inner
./explorer/public/inner/%
./explorer/public/inner/%/directory.metapack
./explorer/public/inner/target
./explorer/public/inner/target/%
./explorer/public/inner/target/%/dependents.metapack
./explorer/public/inner/target/%/schema.metapack
./explorer/public/outer
./explorer/public/outer/%
./explorer/public/outer/%/directory.metapack
./explorer/public/outer/a
./explorer/public/outer/a/%
./explorer/public/outer/a/%/dependents.metapack
./explorer/public/outer/a/%/schema.metapack
./routes.bin
./schemas
./schemas/inner
./schemas/inner/target
./schemas/inner/target/%
./schemas/inner/target/%/blaze-exhaustive.metapack
./schemas/inner/target/%/blaze-fast.metapack
./schemas/inner/target/%/bundle-2020-12.metapack
./schemas/inner/target/%/bundle.metapack
./schemas/inner/target/%/dependencies.metapack
./schemas/inner/target/%/editor.metapack
./schemas/inner/target/%/health.metapack
./schemas/inner/target/%/locations.metapack
./schemas/inner/target/%/positions.metapack
./schemas/inner/target/%/schema.metapack
./schemas/inner/target/%/stats.metapack
./schemas/outer
./schemas/outer/a
./schemas/outer/a/%
./schemas/outer/a/%/blaze-exhaustive.metapack
./schemas/outer/a/%/blaze-fast.metapack
./schemas/outer/a/%/bundle-2020-12.metapack
./schemas/outer/a/%/bundle.metapack
./schemas/outer/a/%/dependencies.metapack
./schemas/outer/a/%/editor.metapack
./schemas/outer/a/%/health.metapack
./schemas/outer/a/%/locations.metapack
./schemas/outer/a/%/positions.metapack
./schemas/outer/a/%/schema.metapack
./schemas/outer/a/%/stats.metapack
./state.bin
./version.json
EOF

COMPARE manifest.txt AGAINST expected.txt
