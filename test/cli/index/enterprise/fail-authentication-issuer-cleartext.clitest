MAKE DIRECTORY private

WRITE private/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "authentication": [
    {
      "type": "jwt",
      "name": "machine",
      "paths": [ "/private" ],
      "issuer": "http://accounts.example.com",
      "audience": "https://example.com",
      "algorithms": [ "RS256" ]
    }
  ],
  "contents": {
    "private": { "path": "./private" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
1> error: An authentication policy issuer must be an https URL
1>   at issuer http://accounts.example.com
1>   at name machine
1>   at path [CWD]/one.json
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
