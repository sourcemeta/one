MAKE DIRECTORY internal

WRITE internal/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "public",
      "algorithm": "identity",
      "name": "open",
      "paths": [ "/internal/open" ],
      "keys": [ { "environmentVariable": "ONE_TEST_KEY_OPEN" } ]
    }
  ],
  "contents": {
    "internal": { "path": "./internal" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The string value "public" was expected to equal the string constant "apiKey"
2>   at instance location "/authentication/0/type"
2>   at evaluate path "/properties/authentication/items/anyOf/0/properties/type/const"
2> The object value was expected to validate against the defined properties subschemas
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/0/properties"
2> The value was expected to be an object that defines properties "algorithms", "audience", "issuer", "name", "paths", and "type"
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/1/required"
2> The value was expected to be an object that defines properties "clientId", "clientSecret", "issuer", "name", "paths", "sessionSecrets", and "type"
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/2/required"
2> The object value was expected to validate against at least one of the 3 given subschemas
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf"
2> Every item in the array value was expected to validate against the given subschema
2>   at instance location "/authentication"
2>   at evaluate path "/properties/authentication/items"
2> The object value was expected to validate against the 6 defined properties subschemas
2>   at instance location ""
2>   at evaluate path "/properties"
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
