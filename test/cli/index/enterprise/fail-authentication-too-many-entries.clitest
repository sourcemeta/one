// The number of authentication entries is capped, and a configuration that
// goes past the cap must fail validation rather than be trimmed.

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    { "type": "public", "paths": [ "/p0" ] },
    { "type": "public", "paths": [ "/p1" ] },
