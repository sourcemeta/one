WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/a"
}
EOF

WRITE schemas/b.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/b"
}
EOF

// Run 1: index two schemas from scratch
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/schemas/a.json
2> Detecting: [CWD]/schemas/b.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

// Run 2: add a third schema that references schema a
// Only the new schema's artifacts and affected directories should rebuild
WRITE schemas/c.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/c",
  "properties": {
    "foo": { "$ref": "https://example.com/a" }
  }
}
EOF
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO output_producing.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN output_producing.txt

WRITE expected.txt UNTIL EOF
2> (  4%) Producing: schemas/example/schemas/c/%/schema.metapack
2> (  9%) Producing: schemas/example/schemas/c/%/dependencies.metapack
2> ( 14%) Producing: schemas/example/schemas/c/%/locations.metapack
2> ( 19%) Producing: schemas/example/schemas/c/%/positions.metapack
2> ( 23%) Producing: schemas/example/schemas/c/%/schema-2020-12.metapack
2> ( 28%) Producing: schemas/example/schemas/c/%/stats.metapack
2> ( 33%) Producing: schemas/example/schemas/c/%/bundle.metapack
2> ( 38%) Producing: schemas/example/schemas/c/%/health.metapack
2> ( 42%) Producing: explorer/public/example/schemas/c/%/schema.metapack
2> ( 47%) Producing: schemas/example/schemas/c/%/blaze-exhaustive.metapack
2> ( 52%) Producing: schemas/example/schemas/c/%/blaze-fast.metapack
2> ( 57%) Producing: schemas/example/schemas/c/%/editor.metapack
2> ( 61%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 66%) Producing: explorer/public/example/schemas/c/%/schema-html.metapack
2> ( 71%) Producing: explorer/public/example/%/directory.metapack
2> ( 76%) Producing: explorer/public/example/schemas/%/directory-html.metapack
2> ( 80%) Producing: explorer/public/%/directory.metapack
2> ( 85%) Producing: explorer/public/example/%/directory-html.metapack
2> ( 90%) Producing: explorer/public/%/directory-html.metapack
2> ( 95%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
2> ( 50%) Combining: explorer/public/example/schemas/a/%/dependents.metapack
2> (100%) Combining: explorer/public/example/schemas/c/%/dependents.metapack
EOF

COMPARE output_producing.txt AGAINST expected.txt
