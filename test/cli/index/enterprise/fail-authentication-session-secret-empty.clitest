// An interactive policy names the variables holding the secrets it signs
// sessions with. Naming none leaves it unable to mint or verify a single
// cookie, so the configuration is refused rather than indexed into a policy
// that denies every login it is asked about.

MAKE DIRECTORY internal

WRITE internal/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "oidc",
      "name": "corporate",
      "paths": [ "/internal" ],
      "issuer": "https://login.example.com",
      "clientId": "registry",
      "clientSecret": { "environmentVariable": "ONE_TEST_OIDC_CLIENT" },
      "sessionSecrets": []
    }
  ],
  "contents": {
    "internal": { "path": "./internal" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The object value was expected to only define properties "algorithm", "keys", "name", "paths", and "type", but it also defines properties "clientId", "clientSecret", "issuer", and "sessionSecrets"
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/0/required"
2> The value was expected to be an object that defines properties "algorithms", "audience", "issuer", "name", "paths", and "type"
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/1/required"
2> The array value was expected to contain at least 1 item but it contained 0 items
2>   at instance location "/authentication/0/sessionSecrets"
2>   at evaluate path "/properties/authentication/items/anyOf/2/properties/sessionSecrets/minItems"
2> The object value was expected to validate against the defined properties subschemas
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/2/properties"
2> The string value "oidc" was expected to equal the string constant "github"
2>   at instance location "/authentication/0/type"
2>   at evaluate path "/properties/authentication/items/anyOf/3/properties/type/const"
2> The object value was expected to validate against the defined properties subschemas
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf/3/properties"
2> The object value was expected to validate against at least one of the 4 given subschemas
2>   at instance location "/authentication/0"
2>   at evaluate path "/properties/authentication/items/anyOf"
2> Every item in the array value was expected to validate against the given subschema
2>   at instance location "/authentication"
2>   at evaluate path "/properties/authentication/items"
2> The object value was expected to validate against the 6 defined properties subschemas
2>   at instance location ""
2>   at evaluate path "/properties"
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
