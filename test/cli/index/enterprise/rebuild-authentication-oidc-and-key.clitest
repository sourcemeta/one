EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

TREE output INTO before.txt
DROP LINES MATCHING '^\./(?!explorer/).*$' IN before.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN before.txt
DROP LINES MATCHING '^\./explorer/corporate/self(/.*)?$' IN before.txt
DROP LINES MATCHING '^\./explorer/vault/self(/.*)?$' IN before.txt

WRITE expected-before.txt UNTIL EOF
./explorer/corporate
./explorer/corporate/%
