// Two policies fronting the same provider name the same client secret and the
// same session secret. Neither variable is ever presented by a caller, so
// sharing them aliases nothing, and each policy still gets a tree of its own

MAKE DIRECTORY alpha
MAKE DIRECTORY beta

WRITE alpha/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/alpha/a",
  "type": "object"
}
EOF

WRITE beta/b.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/beta/b",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "authentication": [
    {
      "type": "oidc",
      "name": "engineering",
      "paths": [ "/alpha" ],
      "issuer": "https://login.example.com",
      "clientId": "registry",
      "clientSecret": { "environmentVariable": "ONE_TEST_OIDC_CLIENT" },
      "sessionSecrets": [
        { "environmentVariable": "ONE_TEST_OIDC_SESSION" }
      ]
    },
    {
      "type": "oidc",
      "name": "support",
      "paths": [ "/beta" ],
      "issuer": "https://login.example.com",
      "clientId": "registry",
      "clientSecret": { "environmentVariable": "ONE_TEST_OIDC_CLIENT" },
      "sessionSecrets": [
        { "environmentVariable": "ONE_TEST_OIDC_SESSION" }
      ]
    }
  ],
  "contents": {
    "alpha": {
      "baseUri": "https://example.com/alpha",
      "path": "./alpha"
    },
    "beta": {
      "baseUri": "https://example.com/beta",
      "path": "./beta"
    }
  }
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log.txt
DROP LINES CONTAINING $ONE_PREFIX IN log.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log.txt
REPLACE $CWD WITH '[CWD]' IN log.txt
SORT log.txt
WRITE expected-log.txt UNTIL EOF
2> Detecting: [CWD]/alpha/a.json
2> Detecting: [CWD]/beta/b.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log.txt AGAINST expected-log.txt

// Each policy sees its own collection and nothing of the other, and anonymous
// callers see neither
TREE output INTO views.txt
DROP LINES MATCHING '^\./(?!explorer/).*$' IN views.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN views.txt
DROP LINES MATCHING '^\./explorer/engineering/self(/.*)?$' IN views.txt
DROP LINES MATCHING '^\./explorer/support/self(/.*)?$' IN views.txt

WRITE expected-views.txt UNTIL EOF
./explorer/engineering
./explorer/engineering/%
./explorer/engineering/%/404.metapack
./explorer/engineering/%/directory-html.metapack
./explorer/engineering/%/directory.metapack
./explorer/engineering/%/mcp.metapack
./explorer/engineering/%/search.metapack
./explorer/engineering/alpha
./explorer/engineering/alpha/%
./explorer/engineering/alpha/%/directory-html.metapack
./explorer/engineering/alpha/%/directory.metapack
./explorer/engineering/alpha/a
./explorer/engineering/alpha/a/%
./explorer/engineering/alpha/a/%/dependents.metapack
./explorer/engineering/alpha/a/%/schema-html.metapack
./explorer/engineering/alpha/a/%/schema.metapack
./explorer/public
./explorer/public/%
./explorer/public/%/404.metapack
./explorer/public/%/directory-html.metapack
./explorer/public/%/directory.metapack
./explorer/public/%/login-html.metapack
./explorer/public/%/login.metapack
./explorer/public/%/mcp.metapack
./explorer/public/%/search.metapack
./explorer/support
./explorer/support/%
./explorer/support/%/404.metapack
./explorer/support/%/directory-html.metapack
./explorer/support/%/directory.metapack
./explorer/support/%/mcp.metapack
./explorer/support/%/search.metapack
./explorer/support/beta
./explorer/support/beta/%
./explorer/support/beta/%/directory-html.metapack
./explorer/support/beta/%/directory.metapack
./explorer/support/beta/b
./explorer/support/beta/b/%
./explorer/support/beta/b/%/dependents.metapack
./explorer/support/beta/b/%/schema-html.metapack
./explorer/support/beta/b/%/schema.metapack
EOF

COMPARE views.txt AGAINST expected-views.txt
