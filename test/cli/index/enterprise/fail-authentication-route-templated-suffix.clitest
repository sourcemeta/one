// A route is named where it begins, not at something it matches. A scope
// reaching into an expansion asks for a gate that could only hold where the
// path is compared literally, and not on the surfaces that reach the same
// endpoint by name

MAKE DIRECTORY private

WRITE private/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "trace",
      "paths": [ "/self/v1/api/schemas/trace/private/secret" ],
      "keys": [ { "environmentVariable": "ONE_TEST_KEY_INTERNAL" } ]
    }
  ],
  "contents": {
    "private": { "path": "./private" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: An authentication policy matches no known collection, page, or route
2>   at scope /self/v1/api/schemas/trace/private/secret
2>   at path [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
