// A schema changing while the policies stay put is the incremental path, and it
// has to reach every view rather than only the first, since each holds its own
// copy of what that schema contributes

MAKE DIRECTORY schemas

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/a",
  "title": "Before",
  "type": "object"
}
EOF

WRITE schemas/b.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/b",
  "$ref": "./a"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "alpha",
      "paths": [ "/schemas" ],
      "keys": [ { "environmentVariable": "ONE_TEST_KEY_ALPHA" } ]
    }
  ],
  "contents": {
    "schemas": {
      "baseUri": "https://example.com/",
      "path": "./schemas"
    }
  }
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^' IN log_1.txt
WRITE silent.txt UNTIL EOF
EOF
COMPARE log_1.txt AGAINST silent.txt

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/a",
  "title": "After",
  "type": "object"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 0
DROP LINES MATCHING '^1>' IN output.txt
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO produced.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN produced.txt

// Every artifact the edit reaches is named twice, once under each view, which is
// what a view left holding the previous contents would be missing from
WRITE expected-produced.txt UNTIL EOF
2> (  3%) Producing: explorer/public/%/directory.metapack
2> (  6%) Producing: schemas/schemas/a/%/schema.metapack
2> ( 10%) Producing: schemas/schemas/b/%/dependencies.metapack
2> ( 13%) Producing: explorer/public/%/directory-html.metapack
2> ( 16%) Producing: explorer/public/%/search.metapack
2> ( 20%) Producing: schemas/schemas/a/%/dependencies.metapack
2> ( 23%) Producing: schemas/schemas/a/%/locations.metapack
2> ( 26%) Producing: schemas/schemas/a/%/positions.metapack
2> ( 30%) Producing: schemas/schemas/a/%/stats.metapack
2> ( 33%) Producing: schemas/schemas/b/%/bundle.metapack
2> ( 36%) Producing: schemas/schemas/b/%/health.metapack
2> ( 40%) Producing: explorer/alpha/schemas/b/%/schema.metapack
2> ( 43%) Producing: explorer/public/%/mcp.metapack
2> ( 46%) Producing: schemas/schemas/a/%/bundle.metapack
2> ( 50%) Producing: schemas/schemas/a/%/health.metapack
2> ( 53%) Producing: schemas/schemas/b/%/blaze-exhaustive.metapack
2> ( 56%) Producing: schemas/schemas/b/%/blaze-fast.metapack
2> ( 60%) Producing: schemas/schemas/b/%/editor.metapack
2> ( 63%) Producing: explorer/alpha/schemas/a/%/schema.metapack
2> ( 66%) Producing: explorer/alpha/schemas/b/%/schema-html.metapack
2> ( 70%) Producing: schemas/schemas/a/%/blaze-exhaustive.metapack
2> ( 73%) Producing: schemas/schemas/a/%/blaze-fast.metapack
2> ( 76%) Producing: schemas/schemas/a/%/editor.metapack
2> ( 80%) Producing: explorer/alpha/schemas/%/directory.metapack
2> ( 83%) Producing: explorer/alpha/schemas/a/%/schema-html.metapack
2> ( 86%) Producing: explorer/alpha/%/directory.metapack
2> ( 90%) Producing: explorer/alpha/schemas/%/directory-html.metapack
2> ( 93%) Producing: explorer/alpha/%/directory-html.metapack
2> ( 96%) Producing: explorer/alpha/%/search.metapack
2> (100%) Producing: explorer/alpha/%/mcp.metapack
EOF

COMPARE produced.txt AGAINST expected-produced.txt

TREE output INTO manifest.txt
DROP LINES MATCHING '^\./(?!explorer/).*$' IN manifest.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN manifest.txt
DROP LINES MATCHING '^\./explorer/alpha/self(/.*)?$' IN manifest.txt

WRITE expected-manifest.txt UNTIL EOF
./explorer/alpha
./explorer/alpha/%
./explorer/alpha/%/404.metapack
./explorer/alpha/%/directory-html.metapack
./explorer/alpha/%/directory.metapack
./explorer/alpha/%/mcp.metapack
./explorer/alpha/%/search.metapack
./explorer/alpha/schemas
./explorer/alpha/schemas/%
./explorer/alpha/schemas/%/directory-html.metapack
./explorer/alpha/schemas/%/directory.metapack
./explorer/alpha/schemas/a
./explorer/alpha/schemas/a/%
./explorer/alpha/schemas/a/%/dependents.metapack
./explorer/alpha/schemas/a/%/schema-html.metapack
./explorer/alpha/schemas/a/%/schema.metapack
./explorer/alpha/schemas/b
./explorer/alpha/schemas/b/%
./explorer/alpha/schemas/b/%/dependents.metapack
./explorer/alpha/schemas/b/%/schema-html.metapack
./explorer/alpha/schemas/b/%/schema.metapack
./explorer/public
./explorer/public/%
./explorer/public/%/404.metapack
./explorer/public/%/directory-html.metapack
./explorer/public/%/directory.metapack
./explorer/public/%/login-html.metapack
./explorer/public/%/login.metapack
./explorer/public/%/mcp.metapack
./explorer/public/%/search.metapack
EOF

COMPARE manifest.txt AGAINST expected-manifest.txt
