WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "private",
      "paths": [ "/private" ],
      "keys": [ { "environmentVariable": "ONE_TEST_CROSS_POLICY_KEY" } ]
    }
  ],
  "contents": {
    "public": { "path": "./public" },
    "private": { "path": "./private" }
  }
}
EOF

MAKE DIRECTORY public
MAKE DIRECTORY private

WRITE private/secret.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE public/leak.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": { "secret": { "$ref": "../private/secret" } }
}
EOF

RUN --skip-banner --concurrency 1 one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: A schema cannot reference a schema behind a stricter authentication policy
1>   at schema http://localhost:8000/public/leak
1>   with reference http://localhost:8000/private/secret
1>   at path [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
