// Whoever holds the key can derive the key its sessions are sealed under, and
// mint one naming whichever policy they please

MAKE DIRECTORY alpha
MAKE DIRECTORY beta

WRITE alpha/schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE beta/schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "alpha",
      "paths": [ "/alpha" ],
      "keys": [ { "environmentVariable": "ONE_TEST_KEY_ALIASED" } ]
    },
    {
      "type": "oidc",
      "name": "beta",
      "paths": [ "/beta" ],
      "issuer": "https://idp.example.com",
      "clientId": "one",
      "clientSecret": { "environmentVariable": "ONE_TEST_CLIENT_SECRET" },
      "sessionSecrets": [ { "environmentVariable": "ONE_TEST_KEY_ALIASED" } ]
    }
  ],
  "contents": {
    "alpha": { "path": "./alpha" },
    "beta": { "path": "./beta" }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
1> error: An authentication policy key is used more than once
1>   at variable ONE_TEST_KEY_ALIASED
1>   at name beta
1>   at path [CWD]/one.json
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
