MAKE DIRECTORY data
MAKE DIRECTORY data/schemas

WRITE data/schemas/included.schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Included",
  "type": "object"
}
EOF

WRITE data/schemas/excluded.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excluded",
  "type": "object"
}
EOF

WRITE data/jsonschema.json UNTIL EOF
{
  "title": "Example",
  "path": "./schemas",
  "extension": [ ".schema.json" ]
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "example": {
      "include": "./data"
    }
  }
}
EOF
RUN one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/data/schemas/included.schema.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

TREE output INTO manifest.txt
DROP LINES MATCHING '^\./schemas/self(/.*)?$' IN manifest.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN manifest.txt

WRITE expected.txt UNTIL EOF
./authentication.bin
./configuration.json
./explorer
./explorer/public
./explorer/public/%
./explorer/public/%/directory.metapack
./explorer/public/%/login.metapack
./explorer/public/%/mcp.metapack
./explorer/public/%/search.metapack
./explorer/public/example
./explorer/public/example/%
./explorer/public/example/%/directory.metapack
./explorer/public/example/included
./explorer/public/example/included/%
./explorer/public/example/included/%/dependents.metapack
./explorer/public/example/included/%/schema.metapack
./routes.bin
./schemas
./schemas/example
./schemas/example/included
./schemas/example/included/%
./schemas/example/included/%/blaze-exhaustive.metapack
./schemas/example/included/%/blaze-fast.metapack
./schemas/example/included/%/bundle-2020-12.metapack
./schemas/example/included/%/bundle.metapack
./schemas/example/included/%/dependencies.metapack
./schemas/example/included/%/editor.metapack
./schemas/example/included/%/health.metapack
./schemas/example/included/%/locations.metapack
./schemas/example/included/%/positions.metapack
./schemas/example/included/%/schema.metapack
./schemas/example/included/%/stats.metapack
./state.bin
./version.json
EOF

COMPARE manifest.txt AGAINST expected.txt
