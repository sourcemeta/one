// A schema switching its dialect from one schema to another rebuilds the
// metadata of both

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/meta-a.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/meta-a"
}
EOF

WRITE schemas/meta-b.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/meta-b"
}
EOF

WRITE schemas/user.json UNTIL EOF
{
  "$schema": "https://example.com/meta-a",
  "$id": "https://example.com/user"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/schemas/meta-a.json
2> Detecting: [CWD]/schemas/meta-b.json
2> Detecting: [CWD]/schemas/user.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

WRITE schemas/user.json UNTIL EOF
{
  "$schema": "https://example.com/meta-b",
  "$id": "https://example.com/user"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO produced.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN produced.txt

// Both schemas declared as the dialect before and after are rebuilt, the one
// left behind first since it no longer waits on the changed schema
WRITE expected-produced.txt UNTIL EOF
2> (  3%) Producing: explorer/public/example/schemas/meta-a/%/schema.metapack
2> (  7%) Producing: schemas/example/schemas/meta-a/%/schema-2019-09.metapack
2> ( 10%) Producing: schemas/example/schemas/meta-a/%/schema-2020-12.metapack
2> ( 14%) Producing: schemas/example/schemas/user/%/schema.metapack
2> ( 17%) Producing: explorer/public/example/schemas/meta-a/%/schema-html.metapack
2> ( 21%) Producing: explorer/public/example/schemas/meta-b/%/schema.metapack
2> ( 25%) Producing: schemas/example/schemas/meta-b/%/schema-2019-09.metapack
2> ( 28%) Producing: schemas/example/schemas/meta-b/%/schema-2020-12.metapack
2> ( 32%) Producing: schemas/example/schemas/user/%/dependencies.metapack
2> ( 35%) Producing: schemas/example/schemas/user/%/locations.metapack
2> ( 39%) Producing: schemas/example/schemas/user/%/positions.metapack
2> ( 42%) Producing: schemas/example/schemas/user/%/stats.metapack
2> ( 46%) Producing: explorer/public/example/schemas/meta-b/%/schema-html.metapack
2> ( 50%) Producing: schemas/example/schemas/user/%/bundle.metapack
2> ( 53%) Producing: schemas/example/schemas/user/%/health.metapack
2> ( 57%) Producing: explorer/public/example/schemas/user/%/schema.metapack
2> ( 60%) Producing: schemas/example/schemas/user/%/blaze-exhaustive.metapack
2> ( 64%) Producing: schemas/example/schemas/user/%/blaze-fast.metapack
2> ( 67%) Producing: schemas/example/schemas/user/%/editor.metapack
2> ( 71%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 75%) Producing: explorer/public/example/schemas/user/%/schema-html.metapack
2> ( 78%) Producing: explorer/public/example/%/directory.metapack
2> ( 82%) Producing: explorer/public/example/schemas/%/directory-html.metapack
2> ( 85%) Producing: explorer/public/%/directory.metapack
2> ( 89%) Producing: explorer/public/example/%/directory-html.metapack
2> ( 92%) Producing: explorer/public/%/directory-html.metapack
2> ( 96%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
2> ( 50%) Combining: explorer/public/example/schemas/meta-a/%/dependents.metapack
2> (100%) Combining: explorer/public/example/schemas/meta-b/%/dependents.metapack
EOF

COMPARE produced.txt AGAINST expected-produced.txt
