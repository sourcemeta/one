MAKE DIRECTORY schemas
MAKE DIRECTORY rules

WRITE schemas/test.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE rules/rule.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "contents": {
    "test": {
      "path": "./schemas",
      "lint": { "rules": [ "./rules/rule.json" ] }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: The schema rule is missing a title
2>   at path [CWD]/rules/rule.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
