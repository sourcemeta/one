// Adding a schema that declares an existing schema as its dialect rebuilds the
// metadata of that schema, and of no unrelated one

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/meta.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/meta"
}
EOF

WRITE schemas/other.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/other"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/schemas/meta.json
2> Detecting: [CWD]/schemas/other.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

WRITE schemas/user.json UNTIL EOF
{
  "$schema": "https://example.com/meta",
  "$id": "https://example.com/user"
}
EOF

RUN --skip-banner --deterministic --concurrency 1 one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO produced.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN produced.txt

// The schema declared as the dialect is rebuilt along with the new one, while
// the unrelated one is left alone
WRITE expected-produced.txt UNTIL EOF
2> (  4%) Producing: schemas/example/schemas/user/%/schema.metapack
2> (  9%) Producing: explorer/public/example/schemas/meta/%/schema.metapack
2> ( 13%) Producing: schemas/example/schemas/user/%/dependencies.metapack
2> ( 18%) Producing: schemas/example/schemas/user/%/locations.metapack
2> ( 22%) Producing: schemas/example/schemas/user/%/positions.metapack
2> ( 27%) Producing: schemas/example/schemas/user/%/stats.metapack
2> ( 31%) Producing: explorer/public/example/schemas/meta/%/schema-html.metapack
2> ( 36%) Producing: schemas/example/schemas/user/%/bundle.metapack
2> ( 40%) Producing: schemas/example/schemas/user/%/health.metapack
2> ( 45%) Producing: explorer/public/example/schemas/user/%/schema.metapack
2> ( 50%) Producing: schemas/example/schemas/user/%/blaze-exhaustive.metapack
2> ( 54%) Producing: schemas/example/schemas/user/%/blaze-fast.metapack
2> ( 59%) Producing: schemas/example/schemas/user/%/editor.metapack
2> ( 63%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 68%) Producing: explorer/public/example/schemas/user/%/schema-html.metapack
2> ( 72%) Producing: explorer/public/example/%/directory.metapack
2> ( 77%) Producing: explorer/public/example/schemas/%/directory-html.metapack
2> ( 81%) Producing: explorer/public/%/directory.metapack
2> ( 86%) Producing: explorer/public/example/%/directory-html.metapack
2> ( 90%) Producing: explorer/public/%/directory-html.metapack
2> ( 95%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
2> ( 50%) Combining: explorer/public/example/schemas/meta/%/dependents.metapack
2> (100%) Combining: explorer/public/example/schemas/user/%/dependents.metapack
EOF

COMPARE produced.txt AGAINST expected-produced.txt
