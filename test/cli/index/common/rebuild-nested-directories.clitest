WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "left": {
      "contents": {
        "left-a": {
          "baseUri": "https://example.com/left/left-a/",
          "path": "./schemas-left-a"
        },
        "left-b": {
          "baseUri": "https://example.com/left/left-b/",
          "path": "./schemas-left-b"
        }
      }
    },
    "right": {
      "contents": {
        "right-a": {
          "baseUri": "https://example.com/right/right-a/",
          "path": "./schemas-right-a"
        },
        "right-b": {
          "baseUri": "https://example.com/right/right-b/",
          "path": "./schemas-right-b"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas-left-a
MAKE DIRECTORY schemas-left-b
MAKE DIRECTORY schemas-right-a
MAKE DIRECTORY schemas-right-b

WRITE schemas-left-a/s1.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/left/left-a/s1"
}
EOF

WRITE schemas-left-b/s2.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/left/left-b/s2"
}
EOF

WRITE schemas-right-a/s3.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/right/right-a/s3"
}
EOF

WRITE schemas-right-b/s4.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/right/right-b/s4"
}
EOF

// Run 1: index four schemas across four directories
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN log_1.txt
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $ONE_PREFIX WITH '[PREFIX]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Detecting: [CWD]/schemas-right-b/s4.json (#1)
2> Detecting: [CWD]/schemas-right-a/s3.json (#2)
2> Detecting: [CWD]/schemas-left-a/s1.json (#3)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/request.json (#4)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/error.json (#5)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/ping/request.json (#6)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/ping/response.json (#7)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/request.json (#8)
