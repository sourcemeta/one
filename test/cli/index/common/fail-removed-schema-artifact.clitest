// The build state records that a build materialised a schema, and an
// incremental build trusts it. The output directory belongs to the indexer, so
// a recorded artifact that is gone from disk means something else modified the
// directory, and the build must refuse loudly instead of continuing over a
// record it cannot honour

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "contents": {
    "schemas": { "baseUri": "https://example.com/", "path": "./schemas" }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/a"
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN log_1.txt
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $ONE_PREFIX WITH '[PREFIX]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Detecting: [CWD]/schemas/a.json (#1)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/request.json (#2)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/error.json (#3)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/ping/request.json (#4)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/ping/response.json (#5)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/request.json (#6)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-dependencies/request.json (#7)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-dependencies/response.json (#8)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-stats/request.json (#9)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-stats/response.json (#10)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-health/request.json (#11)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-health/response.json (#12)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-positions/request.json (#13)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-positions/response.json (#14)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-locations/request.json (#15)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-locations/response.json (#16)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/instance-to-rdf/request.json (#17)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/instance-to-rdf/response.json (#18)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/evaluate-schema/request.json (#19)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/evaluate-schema/response.json (#20)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/response.json (#21)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/search-schemas/request.json (#22)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/search-schemas/response.json (#23)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-dependents/request.json (#24)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/get-schema-dependents/response.json (#25)
2> Detecting: [PREFIX]/share/sourcemeta/one/self/v1/schemas/mcp/tools/call/list-directory/request.json (#26)
