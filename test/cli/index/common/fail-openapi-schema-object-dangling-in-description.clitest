// A Schema Object may name a place within another description of the span,
// which is one of the Schema Objects that description holds. A fragment that
// names no place of it is turned down for what it is, rather than being taken
// for the name of a schema nobody wrote.

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "api": {
      "baseUri": "https://example.com/",
      "path": "./api"
    }
  }
}
EOF

MAKE DIRECTORY api

WRITE api/other.json UNTIL EOF
{
  "openapi": "3.2.0",
  "info": {
    "title": "Other",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Cat": {
        "type": "object"
      }
    }
  }
}
EOF

WRITE api/entry.json UNTIL EOF
{
  "openapi": "3.2.0",
  "info": {
    "title": "Entry",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "A": {
        "$ref": "https://example.com/other#Nope"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: This reference must name a place within the document it points at
2>   at path [CWD]/api/entry.json
2>   at identifier https://sourcemeta.com/api/other#Nope
2>   at location "/components/schemas/A/$ref"
2>   at base https://sourcemeta.com/api/entry
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
