WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

RUN --skip-banner one.json output --resolve-schema 'not a valid{uri' STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Expected a valid URI value for option
2>   at option resolve-schema
2>   with value not a valid{uri
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
