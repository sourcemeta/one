MAKE DIRECTORY meta
MAKE DIRECTORY schemas

WRITE meta/custom.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://other.example.com/meta/custom",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  },
  "$dynamicAnchor": "meta"
}
EOF

WRITE schemas/sample.json UNTIL EOF
{
  "$schema": "urn:example:custom-meta",
  "type": "string"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "meta": {
      "baseUri": "https://other.example.com/meta",
      "path": "./meta"
    },
    "example": {
      "path": "./schemas",
      "resolve": {
        "urn:example:custom-meta": "https://other.example.com/meta/custom"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: Could not resolve the metaschema of the schema
1>   at identifier https://other.example.com/meta/custom
1>   at path [CWD]/schemas/sample.json
1>
1> Did you forget to register a schema with such URI?
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
