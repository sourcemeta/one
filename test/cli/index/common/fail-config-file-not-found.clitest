RUN --skip-banner $CWD/nonexistent.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
1> error: Could not locate the requested file
1>   at path [CWD]/nonexistent.json
2> Writing output to: [CWD]/output
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
