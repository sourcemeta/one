WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/a"
}
EOF

WRITE schemas/b.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/b"
}
EOF

// Run 1: index two schemas from scratch
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO unchecked_1.txt EXPECTING 0
// This build sets the scene for what comes later and its log is
// not what this test is about. Every observation has to be read,
// so the log is thrown away outright rather than dressed up as an
// assertion that could never fail
DROP LINES MATCHING '^' IN unchecked_1.txt
WRITE nothing.txt UNTIL EOF
EOF
COMPARE unchecked_1.txt AGAINST nothing.txt

// Run 2: add a third schema that references schema a
// Only the new schema's artifacts and affected directories should rebuild
WRITE schemas/c.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/c",
  "properties": {
    "foo": { "$ref": "https://example.com/a" }
  }
}
EOF
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO output_producing.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN output_producing.txt

WRITE expected.txt UNTIL EOF
2> (  5%) Producing: schemas/example/schemas/c/%/schema.metapack
2> ( 10%) Producing: schemas/example/schemas/c/%/dependencies.metapack
2> ( 15%) Producing: schemas/example/schemas/c/%/locations.metapack
2> ( 20%) Producing: schemas/example/schemas/c/%/positions.metapack
2> ( 25%) Producing: schemas/example/schemas/c/%/stats.metapack
2> ( 30%) Producing: schemas/example/schemas/c/%/bundle.metapack
2> ( 35%) Producing: schemas/example/schemas/c/%/health.metapack
2> ( 40%) Producing: explorer/public/example/schemas/c/%/schema.metapack
2> ( 45%) Producing: schemas/example/schemas/c/%/blaze-exhaustive.metapack
2> ( 50%) Producing: schemas/example/schemas/c/%/blaze-fast.metapack
2> ( 55%) Producing: schemas/example/schemas/c/%/editor.metapack
2> ( 60%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 65%) Producing: explorer/public/example/schemas/c/%/schema-html.metapack
2> ( 70%) Producing: explorer/public/example/%/directory.metapack
2> ( 75%) Producing: explorer/public/example/schemas/%/directory-html.metapack
2> ( 80%) Producing: explorer/public/%/directory.metapack
2> ( 85%) Producing: explorer/public/example/%/directory-html.metapack
2> ( 90%) Producing: explorer/public/%/directory-html.metapack
2> ( 95%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
2> ( 50%) Combining: explorer/public/example/schemas/a/%/dependents.metapack
2> (100%) Combining: explorer/public/example/schemas/c/%/dependents.metapack
EOF

COMPARE output_producing.txt AGAINST expected.txt
