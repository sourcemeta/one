WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "contents": {
    "example": {
      "title": "Test",
      "extends": [ "./other.json" ]
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: Invalid configuration
1>   at path [CWD]/one.json
1> The value was expected to be an object that defines the property "include"
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/0/required"
1> The object value was not expected to define the property "extends"
1>   at instance location "/contents/example/extends"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/1/$ref/additionalProperties"
1> The object value was not expected to define additional properties
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/1/$ref/additionalProperties"
1> The object value was expected to validate against the referenced schema
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/1/$ref"
1> The object value was not expected to define the property "extends"
1>   at instance location "/contents/example/extends"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/2/$ref/additionalProperties"
1> The object value was not expected to define additional properties
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/2/$ref/additionalProperties"
1> The object value was expected to validate against the referenced schema
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf/2/$ref"
1> The object value was expected to validate against at least one of the 3 given subschemas
1>   at instance location "/contents/example"
1>   at evaluate path "/properties/contents/$ref/additionalProperties/anyOf"
1> The object properties not covered by other adjacent object keywords were expected to validate against this subschema
1>   at instance location "/contents"
1>   at evaluate path "/properties/contents/$ref/additionalProperties"
1> The object value was expected to validate against the referenced schema
1>   at instance location "/contents"
1>   at evaluate path "/properties/contents/$ref"
1> The object value was expected to validate against the 6 defined properties subschemas
1>   at instance location ""
1>   at evaluate path "/properties"
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
