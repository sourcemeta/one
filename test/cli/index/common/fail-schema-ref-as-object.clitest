WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/test.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/test",
  "$ref": {"type": "string"}
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: The schema does not adhere to its metaschema
2> The value was expected to be of type string but it was of type object
2>   at instance location "/$ref"
2>   at evaluate path "/allOf/0/$ref/properties/$ref/$ref/type"
2> The object value was expected to validate against the referenced schema
2>   at instance location "/$ref"
2>   at evaluate path "/allOf/0/$ref/properties/$ref/$ref"
2> The object value was expected to validate against the 9 defined properties subschemas
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref/properties"
2> The object value was expected to validate against the referenced schema
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref"
2> The object value was expected to validate against the 7 given subschemas
2>   at instance location ""
2>   at evaluate path "/allOf"
EOF

COMPARE output.txt AGAINST expected.txt
