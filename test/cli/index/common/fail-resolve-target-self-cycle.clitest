MAKE DIRECTORY schemas

WRITE schemas/sample.json UNTIL EOF
{
  "$schema": "urn:example:a",
  "type": "string"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "example": {
      "path": "./schemas",
      "resolve": {
        "urn:example:a": "urn:example:a"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier urn:example:a
2>   at path [CWD]/schemas/sample.json
2>
2> Did you forget to register a schema with such URI?
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
