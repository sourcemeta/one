MAKE DIRECTORY schemas/foo

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/foo"
}
EOF

WRITE schemas/foo/bar.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/foo/bar"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "example": {
      "baseUri": "https://example.com",
      "path": "./schemas"
    }
  }
}
EOF

RUN one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN log_1.txt
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $ONE_PREFIX WITH '[PREFIX]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Detecting: [CWD]/schemas/foo.json (#1)
2> Detecting: [CWD]/schemas/foo/bar.json (#2)
