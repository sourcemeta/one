WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas",
          "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/petstore.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Petstore",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Pet": {
        "type": "nonsense"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: The OpenAPI description holds a schema that does not adhere to its dialect
2>   at path [CWD]/schemas/petstore.json
2>   at location "/components/schemas/Pet"
2>   at dialect https://spec.openapis.org/oas/3.1/dialect/base
2> The string value "nonsense" was expected to equal one of the following values: "array", "boolean", "integer", "null", "number", "object", and "string"
2>   at instance location "/type"
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/0/$ref/enum"
2> The string value was expected to validate against the referenced schema
2>   at instance location "/type"
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/0/$ref"
2> The value was expected to be of type array but it was of type string
2>   at instance location "/type"
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/1/type"
2> The string value was expected to validate against at least one of the 2 given subschemas
2>   at instance location "/type"
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf"
2> The object value was expected to validate against the 20 defined properties subschemas
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref/properties"
2> The object value was expected to validate against the referenced schema
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref/allOf/3/$ref"
2> The object value was expected to validate against the 7 given subschemas
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref/allOf"
2> The object value was expected to validate against the referenced schema
2>   at instance location ""
2>   at evaluate path "/allOf/0/$ref"
2> The object value was expected to validate against the 2 given subschemas
2>   at instance location ""
2>   at evaluate path "/allOf"
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
