WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/test.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/test.json",
  "type": "string",
  "pattern": "[unclosed"
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: Invalid regular expression
1>   pattern "[unclosed"
1>   at path [CWD]/schemas/test.json
1>   at schema https://sourcemeta.com/example/schemas/test
1>   at location /pattern
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
