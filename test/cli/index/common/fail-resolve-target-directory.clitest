MAKE DIRECTORY schemas
MAKE DIRECTORY somewhere

WRITE schemas/sample.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "contents": {
    "example": {
      "path": "./schemas",
      "resolve": {
        "urn:example:target": "./somewhere"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: The resolve target is not a file
2>   at uri urn:example:target
2>   to path [CWD]/somewhere
2>   at path [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
