// An OpenAPI description reaching a document this catalog holds is one built
// out of several, which the catalog takes in as the documents it is made of,
// each of them a leaf of its own.

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "html": false,
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas",
          "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/shared.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Shared",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "pathItems": {
      "Pets": {
        "get": {
          "responses": {
            "200": {
              "description": "Every pet"
            }
          }
        }
      }
    }
  }
}
EOF

WRITE schemas/petstore.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Petstore",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "$ref": "https://example.com/shared#/components/pathItems/Pets"
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 0
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt

TREE output INTO manifest.txt
DROP LINES MATCHING '^\./schemas/self(/.*)?$' IN manifest.txt
DROP LINES MATCHING '^\./explorer/public/self(/.*)?$' IN manifest.txt

WRITE expected_tree.txt UNTIL EOF
./authentication.bin
./configuration.json
./explorer
./explorer/public
./explorer/public/%
./explorer/public/%/directory.metapack
./explorer/public/%/login.metapack
./explorer/public/%/mcp.metapack
./explorer/public/%/search.metapack
./explorer/public/example
./explorer/public/example/%
./explorer/public/example/%/directory.metapack
./explorer/public/example/schemas
./explorer/public/example/schemas/%
./explorer/public/example/schemas/%/directory.metapack
./routes.bin
./schemas
./schemas/example
./schemas/example/schemas
./schemas/example/schemas/petstore
./schemas/example/schemas/petstore/%
./schemas/example/schemas/petstore/%/data.metapack
./schemas/example/schemas/shared
./schemas/example/schemas/shared/%
./schemas/example/schemas/shared/%/data.metapack
./state.bin
./version.json
EOF

COMPARE manifest.txt AGAINST expected_tree.txt
