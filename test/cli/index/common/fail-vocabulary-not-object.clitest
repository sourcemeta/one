WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/custom-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/custom-meta",
  "$vocabulary": "not-an-object"
}
EOF

WRITE schemas/test.json UNTIL EOF
{
  "$schema": "https://example.com/custom-meta",
  "$id": "https://example.com/test",
  "type": "string"
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: The schema does not adhere to its metaschema
1> The value was expected to be of type object but it was of type string
1>   at instance location "/$vocabulary"
1>   at evaluate path "/allOf/0/$ref/properties/$vocabulary/type"
1> The object value was expected to validate against the 9 defined properties subschemas
1>   at instance location ""
1>   at evaluate path "/allOf/0/$ref/properties"
1> The object value was expected to validate against the referenced schema
1>   at instance location ""
1>   at evaluate path "/allOf/0/$ref"
1> The object value was expected to validate against the 7 given subschemas
1>   at instance location ""
1>   at evaluate path "/allOf"
EOF

COMPARE output.txt AGAINST expected.txt
