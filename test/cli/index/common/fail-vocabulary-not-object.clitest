WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/custom-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/custom-meta",
  "$vocabulary": "not-an-object"
}
EOF

WRITE schemas/test.json UNTIL EOF
{
  "$schema": "https://example.com/custom-meta",
  "$id": "https://example.com/test",
  "type": "string"
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt
REPLACE $CWD WITH '[CWD]' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: The vocabularies of a metaschema must be an object
2>   at vocabulary https://sourcemeta.com/example/schemas/custom-meta
2>   at path [CWD]/schemas/test.json
EOF

COMPARE output.txt AGAINST expected.txt
