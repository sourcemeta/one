// What a reference expects to find at the far end is fixed by where the
// reference sits, so one reaching a position of its own document that is
// already read as something else asks that place to be two things at once.

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "api": {
      "baseUri": "https://example.com/",
      "path": "./api"
    }
  }
}
EOF

MAKE DIRECTORY api

WRITE api/entry.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Entry",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "$ref": "#/components/schemas/Pet"
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: This place is read as more than one kind of Object
2>   at path [CWD]/api/entry.json
2>   at location "/components/schemas/Pet"
2>   at base https://example.com/entry
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
