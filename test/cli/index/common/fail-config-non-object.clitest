// A configuration whose root is not an object must fail with a schema
// validation error rather than crash while normalising the document.

WRITE one.json UNTIL EOF
[]
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output_0.txt EXPECTING 1
REPLACE $CWD WITH '[CWD]' IN output_0.txt

WRITE expected_0.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The value was expected to be an object that defines the property "url"
2>   at instance location ""
2>   at evaluate path "/required"
EOF

COMPARE output_0.txt AGAINST expected_0.txt

WRITE one.json UNTIL EOF
"sourcemeta"
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output_1.txt EXPECTING 1
REPLACE $CWD WITH '[CWD]' IN output_1.txt

WRITE expected_1.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The value was expected to be an object that defines the property "url"
2>   at instance location ""
2>   at evaluate path "/required"
EOF

COMPARE output_1.txt AGAINST expected_1.txt

WRITE one.json UNTIL EOF
1
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output_2.txt EXPECTING 1
REPLACE $CWD WITH '[CWD]' IN output_2.txt

WRITE expected_2.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The value was expected to be an object that defines the property "url"
2>   at instance location ""
2>   at evaluate path "/required"
EOF

COMPARE output_2.txt AGAINST expected_2.txt

WRITE one.json UNTIL EOF
true
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output_3.txt EXPECTING 1
REPLACE $CWD WITH '[CWD]' IN output_3.txt

WRITE expected_3.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The value was expected to be an object that defines the property "url"
2>   at instance location ""
2>   at evaluate path "/required"
EOF

COMPARE output_3.txt AGAINST expected_3.txt

WRITE one.json UNTIL EOF
null
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output_4.txt EXPECTING 1
REPLACE $CWD WITH '[CWD]' IN output_4.txt

WRITE expected_4.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The value was expected to be an object that defines the property "url"
2>   at instance location ""
2>   at evaluate path "/required"
EOF

COMPARE output_4.txt AGAINST expected_4.txt
