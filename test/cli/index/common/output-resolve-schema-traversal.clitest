// A percent-encoded traversal in the resolved URI must never escape the
// collection directory into a sibling path.

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "schemas": {
      "baseUri": "https://example.com/",
      "path": "./schemas"
    }
  }
}
EOF

MAKE DIRECTORY schemas
MAKE DIRECTORY secret

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/foo"
}
EOF

WRITE secret/passwd.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/passwd"
}
EOF

// A legitimate resolution inside the collection still works
RUN one.json output --resolve-schema https://sourcemeta.com/schemas/foo.json STDIN /dev/null IN . INTO resolved_0.txt EXPECTING 0
REPLACE $CWD WITH '[CWD]' IN resolved_0.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_0.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/foo.json
EOF

COMPARE resolved_0.txt AGAINST expected_0.txt

// Dot-segment traversals are removed and never reach the sibling directory
RUN one.json output --resolve-schema https://sourcemeta.com/schemas/%2E%2E/secret/passwd STDIN /dev/null IN . INTO resolved_1.txt EXPECTING 1

WRITE expected_1.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/../secret/passwd
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_1.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_1.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_1.txt
COMPARE resolved_1.txt AGAINST expected_1.txt

RUN one.json output --resolve-schema https://sourcemeta.com/schemas/%2E%2E/%2E%2E/secret/passwd STDIN /dev/null IN . INTO resolved_2.txt EXPECTING 1

WRITE expected_2.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/../../secret/passwd
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_2.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_2.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_2.txt
COMPARE resolved_2.txt AGAINST expected_2.txt

RUN one.json output --resolve-schema /schemas/%2E%2E/secret/passwd STDIN /dev/null IN . INTO resolved_3.txt EXPECTING 1

WRITE expected_3.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/../secret/passwd
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_3.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_3.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_3.txt
COMPARE resolved_3.txt AGAINST expected_3.txt

// A fully percent-encoded separator stays a single, contained filename rather
// than escaping into the sibling directory
RUN one.json output --resolve-schema https://sourcemeta.com/schemas/%2E%2E%2Fsecret%2Fpasswd STDIN /dev/null IN . INTO resolved_4.txt EXPECTING 0
REPLACE $CWD WITH '[CWD]' IN resolved_4.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_4.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_4.txt

WRITE expected_4.txt UNTIL EOF
1> [CWD]/schemas/..%2Fsecret%2Fpasswd.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/..%2Fsecret%2Fpasswd
EOF

COMPARE resolved_4.txt AGAINST expected_4.txt
