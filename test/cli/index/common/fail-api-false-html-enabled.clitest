WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "api": false,
  "html": {
    "name": "Title",
    "description": "Description"
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: Invalid configuration
2>   at path [CWD]/one.json
2> The object value {"name":"Title","description":"Description"} was expected to equal the boolean constant false
2>   at instance location "/html"
2>   at evaluate path "/dependentSchemas/api/then/properties/html/const"
2> The object value was expected to validate against the single defined property subschema
2>   at instance location ""
2>   at evaluate path "/dependentSchemas/api/then/properties"
2> The object value defined the property "api"
2>   at instance location ""
2>   at evaluate path "/dependentSchemas"
2> Because the object value defined the property "api", it was also expected to validate against the corresponding subschema
2>   at instance location ""
2>   at evaluate path "/dependentSchemas"
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
