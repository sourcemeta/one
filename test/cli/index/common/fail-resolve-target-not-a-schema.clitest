MAKE DIRECTORY schemas

WRITE schemas/sample.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE schemas/notes.txt UNTIL EOF
This file is not a schema
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "contents": {
    "example": {
      "path": "./schemas",
      "resolve": {
        "urn:example:target": "./schemas/notes.txt"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: The file does not contain a valid JSON Schema
2>   at path [CWD]/schemas/notes.txt
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
