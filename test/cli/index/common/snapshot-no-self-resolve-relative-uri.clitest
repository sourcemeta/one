MAKE DIRECTORY meta
MAKE DIRECTORY schemas

WRITE meta/custom.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  },
  "$dynamicAnchor": "meta"
}
EOF

WRITE schemas/sample.json UNTIL EOF
{
  "$schema": "urn:example:custom-meta",
  "type": "string"
}
EOF

WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000",
  "html": false,
  "contents": {
    "meta": {
      "path": "./meta"
    },
    "example": {
      "path": "./schemas",
      "resolve": {
        "urn:example:custom-meta": "/meta/custom.json"
      }
    }
  }
}
EOF
RUN one.json output STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN log_1.txt
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
REPLACE $ONE_PREFIX WITH '[PREFIX]' IN log_1.txt
REPLACE $EDITION WITH '[EDITION]' IN log_1.txt
REPLACE $VERSION WITH '[VERSION]' IN log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Detecting: [CWD]/schemas/sample.json (#1)
2> Detecting: [CWD]/meta/custom.json (#2)
