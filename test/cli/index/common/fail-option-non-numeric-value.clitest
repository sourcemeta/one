WRITE one.json UNTIL EOF
{ "url": "https://sourcemeta.com" }
EOF

RUN --skip-banner one.json output --concurrency abc STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: Expected a valid numeric value for option
1>   at option concurrency
1>   with value abc
EOF

COMPARE output.txt AGAINST expected.txt
