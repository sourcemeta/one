EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

// Run 2: add a third schema
// The affected directory listings still rebuild, but a headless instance renders
// no web page for any of them, so no login nor directory page is ever produced
WRITE schemas/c.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/c"
}
EOF
RUN --skip-banner one.json output --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
COPY output.txt TO output_producing.txt
DROP LINES MATCHING '^(?!.*(Producing|Combining)).*$' IN output_producing.txt

WRITE expected.txt UNTIL EOF
2> (  6%) Producing: schemas/example/schemas/c/%/schema.metapack
2> ( 12%) Producing: schemas/example/schemas/c/%/dependencies.metapack
2> ( 18%) Producing: schemas/example/schemas/c/%/locations.metapack
2> ( 25%) Producing: schemas/example/schemas/c/%/positions.metapack
2> ( 31%) Producing: schemas/example/schemas/c/%/stats.metapack
2> ( 37%) Producing: schemas/example/schemas/c/%/bundle.metapack
2> ( 43%) Producing: schemas/example/schemas/c/%/health.metapack
2> ( 50%) Producing: explorer/public/example/schemas/c/%/schema.metapack
2> ( 56%) Producing: schemas/example/schemas/c/%/blaze-exhaustive.metapack
2> ( 62%) Producing: schemas/example/schemas/c/%/blaze-fast.metapack
2> ( 68%) Producing: schemas/example/schemas/c/%/editor.metapack
2> ( 75%) Producing: explorer/public/example/schemas/%/directory.metapack
2> ( 81%) Producing: explorer/public/example/%/directory.metapack
2> ( 87%) Producing: explorer/public/%/directory.metapack
2> ( 93%) Producing: explorer/public/%/search.metapack
2> (100%) Producing: explorer/public/%/mcp.metapack
2> (100%) Combining: explorer/public/example/schemas/c/%/dependents.metapack
EOF

COMPARE output_producing.txt AGAINST expected.txt
