// Removing a schema that is still referenced by another schema should
// cause the indexer to fail, as the reference cannot be resolved.

WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/a.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/a"
}
EOF

WRITE schemas/b.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/b",
  "properties": {
    "foo": { "$ref": "https://example.com/a" }
  }
}
EOF

// Run 1: full build from scratch
// This build sets the scene for what comes after it and its log is
// not what this test is about. Every observation has to be read, so
// the log is thrown away outright rather than dressed up as an
// assertion that could never fail
RUN --skip-banner one.json output STDIN /dev/null IN . INTO unchecked_1.txt EXPECTING 0
DROP LINES MATCHING '^' IN unchecked_1.txt
WRITE nothing.txt UNTIL EOF
EOF
COMPARE unchecked_1.txt AGAINST nothing.txt

// Run 2: remove schema A (which is referenced by B)
REMOVE schemas/a.json
RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2>' IN output.txt

WRITE expected.txt UNTIL EOF
1> error: Could not resolve the reference to an external schema
1>   at identifier https://sourcemeta.com/example/schemas/a
1>   at path [CWD]/schemas/b.json
1>
1> Did you forget to register a schema with such URI?
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
