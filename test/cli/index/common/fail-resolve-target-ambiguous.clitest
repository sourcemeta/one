MAKE DIRECTORY schemas
MAKE DIRECTORY other

WRITE schemas/target.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE other/sample.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE one.json UNTIL EOF
{
  "url": "https://example.com",
  "contents": {
    "first": { "path": "./schemas" },
    "second": { "path": "./schemas" },
    "example": {
      "path": "./other",
      "resolve": {
        "urn:example:target": "./schemas/target.json"
      }
    }
  }
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: The resolve target is part of more than one schema collection
2>   at uri urn:example:target
2>   to path [CWD]/schemas/target.json
2>   at path [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
