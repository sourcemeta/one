WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "schemas": {
      "baseUri": "https://example.com/",
      "path": "./schemas"
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/foo"
}
EOF

// Absolute URI match (long option)
RUN one.json output --resolve-schema https://sourcemeta.com/schemas/foo.json STDIN /dev/null IN . INTO resolved_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/foo.json
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_0.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_0.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_0.txt
COMPARE resolved_0.txt AGAINST expected_0.txt

// Absolute URI match (short option)
RUN one.json output -r https://sourcemeta.com/schemas/foo.json STDIN /dev/null IN . INTO resolved_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/foo.json
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_1.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_1.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_1.txt
COMPARE resolved_1.txt AGAINST expected_1.txt

// Path-only match
RUN one.json output --resolve-schema /schemas/foo.json STDIN /dev/null IN . INTO resolved_2.txt EXPECTING 0

WRITE expected_2.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/foo.json
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_2.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_2.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_2.txt
COMPARE resolved_2.txt AGAINST expected_2.txt

// Path without .json extension appends .json
RUN one.json output --resolve-schema /schemas/foo STDIN /dev/null IN . INTO resolved_3.txt EXPECTING 0

WRITE expected_3.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/foo
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_3.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_3.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_3.txt
COMPARE resolved_3.txt AGAINST expected_3.txt

// Non-.json extension gets .json appended
RUN one.json output --resolve-schema /schemas/foo.schema STDIN /dev/null IN . INTO resolved_4.txt EXPECTING 0

WRITE expected_4.txt UNTIL EOF
1> [CWD]/schemas/foo.schema.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/foo.schema
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_4.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_4.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_4.txt
COMPARE resolved_4.txt AGAINST expected_4.txt

// .yaml extension gets .json appended
RUN one.json output --resolve-schema /schemas/foo.yaml STDIN /dev/null IN . INTO resolved_5.txt EXPECTING 0

WRITE expected_5.txt UNTIL EOF
1> [CWD]/schemas/foo.yaml.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/foo.yaml
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_5.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_5.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_5.txt
COMPARE resolved_5.txt AGAINST expected_5.txt

// Dotted version-like name gets .json appended
RUN one.json output --resolve-schema /schemas/v1.2.3 STDIN /dev/null IN . INTO resolved_6.txt EXPECTING 0

WRITE expected_6.txt UNTIL EOF
1> [CWD]/schemas/v1.2.3.json
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /schemas/v1.2.3
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_6.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_6.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_6.txt
COMPARE resolved_6.txt AGAINST expected_6.txt

// No match
RUN one.json output --resolve-schema /unknown/foo STDIN /dev/null IN . INTO resolved_7.txt EXPECTING 1

WRITE expected_7.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: /unknown/foo
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_7.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_7.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_7.txt
COMPARE resolved_7.txt AGAINST expected_7.txt

// Wrong origin
RUN one.json output --resolve-schema https://other.com/schemas/foo.json STDIN /dev/null IN . INTO resolved_8.txt EXPECTING 1

WRITE expected_8.txt UNTIL EOF
2> Sourcemeta One [EDITION] v[VERSION]
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://other.com/schemas/foo.json
EOF

REPLACE $CWD WITH '[CWD]' IN resolved_8.txt
REPLACE $EDITION WITH '[EDITION]' IN resolved_8.txt
REPLACE $VERSION WITH '[VERSION]' IN resolved_8.txt
COMPARE resolved_8.txt AGAINST expected_8.txt

// A full run to assert on standard error output. Both streams are captured at
// once here, standard output in full before standard error
RUN one.json output --skip-banner --resolve-schema https://sourcemeta.com/schemas/foo.json STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE $CWD WITH '[CWD]' IN output.txt

WRITE expected.txt UNTIL EOF
1> [CWD]/schemas/foo.json
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> Resolving schema for URI: https://sourcemeta.com/schemas/foo.json
EOF

COMPARE output.txt AGAINST expected.txt
