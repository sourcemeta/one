WRITE one.json UNTIL EOF
{
  "url": "http://localhost:8000?foo=bar",
  "contents": {
    "example": {
      "path": "./schemas"
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/example.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

RUN --skip-banner one.json output STDIN /dev/null IN . INTO output.txt EXPECTING 1

WRITE expected.txt UNTIL EOF
2> Writing output to: [CWD]/output
2> Using configuration: [CWD]/one.json
2> error: The instance URL must contain no credentials, query, or fragment
2>   at url http://localhost:8000?foo=bar
2>   at path [CWD]/one.json
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt
