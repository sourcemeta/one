{
  "openapi": "3.2.0",
  "info": {
    "title": "Split",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "$ref": "https://example.com/schemas/openapi-split-shared#/components/pathItems/Pets"
    }
  },
  "components": {
    "schemas": {
      "Dog": {
        "type": "object",
        "properties": {
          "pet": {
            "$ref": "https://example.com/schemas/openapi-split-shared#/components/schemas/Pet"
          }
        }
      },
      "Any": {
        "oneOf": [
          {
            "$ref": "https://example.com/schemas/openapi-split-shared#/components/schemas/Pet"
          },
          {
            "$ref": "#/components/schemas/Dog"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "pet": "https://example.com/schemas/openapi-split-shared#/components/schemas/Pet",
            "dog": "Dog"
          }
        }
      }
    }
  }
}
