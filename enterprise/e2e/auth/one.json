{
  "url": "http://localhost:8000",
  "html": {
    "name": "Authentication Sandbox",
    "description": "Fixtures exercising a public registry with apiKey-gated components"
  },
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "reports",
      "paths": [ "/private", "/reports" ],
      "keys": [
        { "environmentVariable": "ONE_E2E_KEY_PRIMARY" },
        { "environmentVariable": "ONE_E2E_KEY_SECONDARY" }
      ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "internal",
      "paths": [ "/internal" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_INTERNAL" } ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "surface",
      "paths": [ "/self/v1/health" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_SURFACE" } ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "mixed-plain",
      "paths": [ "/mixed" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_MIXED_PLAIN" } ]
    },
    {
      "type": "apiKey",
      "algorithm": "sha256",
      "name": "mixed-hashed",
      "paths": [ "/mixed" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_MIXED_HASHED" } ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "mixed-blank",
      "paths": [ "/mixed" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_BLANK" } ]
    },
    {
      "type": "jwt",
      "name": "machine",
      "paths": [ "/machine" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://schemas.example.com",
      "algorithms": [ "RS256" ]
    },
    {
      "type": "jwt",
      "name": "telemetry",
      "paths": [ "/telemetry" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://reports.example.com",
      "jwksUri": "https://keycloak:8443/realms/main/protocol/openid-connect/certs",
      "algorithms": [ "RS256" ]
    },
    {
      "type": "jwt",
      "name": "typed",
      "paths": [ "/typed" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://typed.example.com",
      "tokenType": "at+jwt",
      "algorithms": [ "RS256" ]
    },
    {
      "type": "jwt",
      "name": "strict",
      "paths": [ "/strict" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://schemas.example.com",
      "algorithms": [ "ES256" ]
    },
    {
      "type": "jwt",
      "name": "scoped",
      "paths": [ "/scoped" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://schemas.example.com",
      "algorithms": [ "RS256" ],
      "claims": {
        "groups": [ "platform" ],
        "scope": [ "registry:read" ]
      }
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "console",
      "paths": [ "/console" ],
      "keys": [ { "environmentVariable": "ONE_E2E_KEY_CONSOLE" } ]
    },
    {
      "type": "oidc",
      "name": "keycloak",
      "paths": [ "/console" ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [ { "environmentVariable": "ONE_E2E_OIDC_SESSION_SECRET" } ]
    }
  ],
  "contents": {
    "public": { "path": "./schemas/public" },
    "private": { "path": "./schemas/private" },
    "reports": { "path": "./schemas/reports" },
    "internal": { "path": "./schemas/internal" },
    "orphan": { "path": "./schemas/orphan" },
    "mixed": { "path": "./schemas/mixed" },
    "machine": { "path": "./schemas/machine" },
    "telemetry": { "path": "./schemas/telemetry" },
    "strict": { "path": "./schemas/strict" },
    "scoped": { "path": "./schemas/scoped" },
    "typed": { "path": "./schemas/typed" },
    "console": { "path": "./schemas/console" }
  }
}
