      "path": "./schemas/openapi3.0",
      "defaultDialect": "tag:spec.openapis.org,2024-10-18:oas/3.0/dialect",
      "lint": {
        "exclude": [ "top_level_examples" ]
      }
    },
    "twins": {
      "title": "Twins",
      "description": "Schemas whose base name collides with a sibling directory",
      "path": "./schemas/twins"
    },
    "no-blaze": {
      "path": "./schemas/no-blaze",
      "x-sourcemeta-one:evaluate": false
    }
  }
