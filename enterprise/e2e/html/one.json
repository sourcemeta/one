  "contents": {
    "test": {
      "path": "./schemas/test",
      "lint": {
        "rules": [
          "./rules/camelcase.json",
          { "path": "./rules/jsonld-type.json", "topLevel": true }
        ]
      }
    },
    "openapi3.0": {
      "title": "OpenAPI 3.0",
