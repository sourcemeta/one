# A revision that predates the field is assumed when none arrives,
# which is what keeps the oldest clients working. What the body says
# about itself is not read on that revision
POST {{base}}/self/v1/mcp
Accept: application/json, text/event-stream
Content-Type: application/json
```
{
  "jsonrpc": "2.0",
  "id": 412,
  "method": "tools/list",
  "params": {
    "_meta": {
      "io.modelcontextprotocol/protocolVersion": "2026-07-28",
      "io.modelcontextprotocol/clientCapabilities": {},
      "io.modelcontextprotocol/clientInfo": {
        "name": "hurl",
        "version": "1.0.0"
      }
    }
  }
}
