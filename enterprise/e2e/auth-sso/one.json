{
  "url": "http://localhost:8000",
  "html": {
    "name": "SSO Sandbox",
    "description": "A registry whose private catalogs are gated by a single interactive OpenID Connect policy"
  },
  "authentication": [
    {
      "type": "oidc",
      "name": "keycloak",
      "paths": [
        "/private",
        "/archive"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_SESSION_SECRET"
        }
      ]
    },
    {
      "type": "oidc",
      "name": "team",
      "paths": [
        "/team"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_SESSION_SECRET"
        }
      ],
      "claims": {
        "groups": [
          "platform"
        ]
      }
    },
    {
      "type": "oidc",
      "name": "corp",
      "paths": [
        "/corp"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_SESSION_SECRET"
        }
      ],
      "emailDomains": [
        "acme.test"
      ]
    },
    {
      "type": "oidc",
      "name": "cleartext",
      "paths": [
        "/discovery"
      ],
      "issuer": "https://keycloak:8443/realms/cleartext",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLEARTEXT_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_CLEARTEXT_SESSION_SECRET"
        }
      ]
    },
    {
      "type": "oidc",
      "name": "encrypted",
      "paths": [
        "/discovery"
      ],
      "issuer": "https://keycloak:8443/realms/encrypted",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_ENCRYPTED_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_ENCRYPTED_SESSION_SECRET"
        }
      ]
    },
    {
      "type": "oidc",
      "name": "no-client-secret",
      "paths": [
        "/unavailable"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_ABSENT_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_BROKEN_SESSION_SECRET"
        }
      ]
    },
    {
      "type": "oidc",
      "name": "no-session-secret",
      "paths": [
        "/unavailable"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_BROKEN_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_ABSENT_SESSION_SECRET"
        }
      ]
    },
    {
      "type": "oidc",
      "name": "rotated",
      "paths": [
        "/rotated"
      ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [
        {
          "environmentVariable": "ONE_E2E_OIDC_ROTATED_SESSION_SECRET"
        },
        {
          "environmentVariable": "ONE_E2E_OIDC_ROTATED_SESSION_SECRET_OLD"
        }
      ]
    }
  ],
  "contents": {
    "public": {
      "path": "./schemas/public"
    },
    "private": {
      "path": "./schemas/private"
    },
    "archive": {
      "path": "./schemas/archive"
    },
    "discovery": {
      "path": "./schemas/discovery"
    },
    "unavailable": {
      "path": "./schemas/unavailable"
    },
    "rotated": {
      "path": "./schemas/rotated"
    },
    "team": {
      "path": "./schemas/team"
    },
    "corp": {
      "path": "./schemas/corp"
    }
  }
}
