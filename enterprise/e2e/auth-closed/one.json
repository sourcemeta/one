{
  "url": "http://localhost:8000",
  "html": {
    "name": "Fully Private Sandbox",
    "description": "A registry locked in its entirety, opened by an apiKey, a JWT, or an interactive session"
  },
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "registry",
      "paths": [ "/" ],
      "keys": [ { "environmentVariable": "ONE_E2E_FULL_KEY" } ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "mcp",
      "paths": [ "/self/v1/mcp" ],
      "keys": [ { "environmentVariable": "ONE_E2E_MCP_KEY" } ]
    },
    {
      "type": "jwt",
      "name": "mcp-tokens",
      "paths": [ "/self/v1/mcp" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "http://localhost:8000/self/v1/mcp",
      "algorithms": [ "RS256" ]
    },
    {
      "type": "jwt",
      "name": "machine",
      "paths": [ "/" ],
      "issuer": "https://keycloak:8443/realms/main",
      "audience": "https://schemas.example.com",
      "algorithms": [ "RS256" ]
    },
    {
      "type": "oidc",
      "name": "keycloak",
      "paths": [ "/" ],
      "issuer": "https://keycloak:8443/realms/main",
      "clientId": "registry",
      "clientSecret": {
        "environmentVariable": "ONE_E2E_OIDC_CLIENT_SECRET"
      },
      "sessionSecrets": [ { "environmentVariable": "ONE_E2E_OIDC_SESSION_SECRET" } ]
    }
  ],
  "contents": {
    "catalog": { "path": "./schemas" }
  }
}
